local fs=require("@lune/fs")
local serde=require("@lune/serde")
local R=require("@lune/roblox")
local Rules=require("../src/shared/MatchRules")
local Round=require("../src/shared/RoundModel")
local Profile=require("../src/shared/Profile")
local Sessions=require("../src/shared/SessionStore")
local Selection=require("../src/shared/ChaosSelection")
local Limiter=require("../src/shared/RateLimiter")
local Util=require("../src/shared/Util")
local Config=require("../src/shared/Config")
local Validator=require("../src/shared/RequestValidation")
local report={Kind="offline Luau rules/data tests; NOT Roblox engine playtest",Passed=0,Failed=0,Tests={}}
local function equal(actual,expected) assert(actual==expected,"expected "..tostring(expected)..", got "..tostring(actual)) end
local function test(name,fn)
    local ok,err=pcall(fn)
    table.insert(report.Tests,{Name=name,Passed=ok,Error=if ok then nil else tostring(err)})
    if ok then report.Passed+=1 else report.Failed+=1;print("FAIL "..name..": "..tostring(err)) end
end
for n=2,16 do test("valid decreasing tournament roster "..n,function()
    local plan=Rules.plan(n);equal(plan[#plan].Mode,"Final")
    local previous=n
    for index,stage in plan do
        assert(stage.Duration>=45 and stage.Duration<=120)
        if index<#plan then assert(stage.Quota<previous and stage.Quota>=2);previous=stage.Quota end
    end
    assert(previous<=4)
end) end
test("8 player reference quotas",function() local p=Rules.plan(8);equal(p[1].Quota,6);equal(p[2].Quota,4);equal(#p,3) end)
test("16 player full format",function() local p=Rules.plan(16);equal(p[1].Quota,12);equal(p[2].Quota,8);equal(p[3].Quota,4);equal(#p,4) end)
test("solo requires explicit test option",function() assert(not pcall(Rules.plan,1));equal(#Rules.plan(1,true),3) end)
test("roster rejects fraction/overflow",function() assert(not pcall(Rules.plan,2.5));assert(not pcall(Rules.plan,17)) end)
test("race duplicate finish rejected",function() local r=Round.new("Race",{1,2,3},2,100);r:batch({},{1,1},5);equal(#r.Order,1);r:batch({},{1},6);equal(#r.Order,1) end)
test("race quota boundary ties share rank and qualify",function() local r=Round.new("Race",{1,2,3,4},2,100);r:batch({},{1},5);r:batch({},{4,3,2},6);equal(#r.Order,4);equal(r.Placements[2],2);equal(r.Placements[3],2);equal(r.Placements[4],2);assert(r.Done) end)
test("finish after deadline refused",function() local r=Round.new("Race",{1,2},1,10);r:batch({},{1},10.01);equal(#r.Order,0);r:expire(10.01,20);assert(r.Done) end)
test("finish exactly on deadline accepted",function() local r=Round.new("Race",{1,2},1,10);r:batch({},{1},10);equal(#r.Order,1) end)
test("death dominates same sample finish",function() local r=Round.new("Final",{1,2},1,100);r:batch({1},{1},5);equal(r.Winner,2) end)
test("all final deaths draw regardless order",function() for _,deaths in {{1,2},{2,1}} do local r=Round.new("Final",{1,2},1,100);r:batch(deaths,{},5);assert(r.Done and r.Draw and r.Winner==nil) end end)
test("crown finish chooses valid player",function() local r=Round.new("Final",{1,2,3},1,100);r:batch({},{3},5);equal(r.Winner,3) end)
test("indistinguishable crown finish is draw",function() local r=Round.new("Final",{1,2},1,100);r:batch({},{1,2},5);assert(r.Draw and r.Winner==nil) end)
test("solo does not auto-win immediately",function() local r=Round.new("Final",{1},1,100,true);r:batch({},{},5);assert(not r.Done);r:batch({},{1},8);equal(r.Winner,1) end)
test("survival threshold qualifies actual survivors",function() local r=Round.new("Survival",{1,2,3,4},2,10);r:batch({1,3},{},5);equal(#r.Order,2);assert(r.Qualified[2] and r.Qualified[4]) end)
test("survival deadline overtime then all remaining",function() local r=Round.new("Survival",{1,2,3,4},2,10);equal(r:expire(10,20),"Overtime");equal(r.Deadline,30);equal(r:expire(30,20),"Ended");equal(#r.Order,4) end)
test("zero survival survivors cannot receive qualification",function() local r=Round.new("Survival",{1,2},1,100);r:batch({1,2},{},5);assert(r.Draw);equal(#r.Order,0) end)
test("finished round ignores old callbacks",function() local r=Round.new("Final",{1,2},1,100);r:batch({},{1},5);r:batch({1},{2},6);equal(r.Winner,1) end)
test("defaults never share settings tables",function() local a,b=Profile.new(),Profile.new();a.Settings.SFX=0;equal(b.Settings.SFX,0.7) end)
test("reward and quest updates are idempotent",function() local p=Profile.new();assert(Profile.grant(p,"round1",50,15,{Qualifications=1},200));assert(not Profile.grant(p,"round1",50,15,{Qualifications=1},200));equal(p.Crowns,15);equal(p.Statistics.Qualifications,1);equal(p.Quests.Counts.Qualify,1) end)
test("invalid numeric reward cannot mutate",function() local p=Profile.new();assert(not Profile.grant(p,"x",0/0,10,nil,1));equal(p.Crowns,0);assert(not p.Ledger.Keys.x) end)
test("currency cannot go negative or double-buy",function() local p=Profile.new();assert(not Profile.buy(p,"CloudTrail"));p.Crowns=100;assert(Profile.buy(p,"CloudTrail"));assert(not Profile.buy(p,"CloudTrail"));equal(p.Crowns,25) end)
test("equip requires ownership and catalog entry",function() local p=Profile.new();assert(not Profile.equip(p,"ChaosTrail"));assert(not Profile.equip(p,"ArbitraryAdminItem")) end)
test("daily claim cannot repeat same or older day",function() local p=Profile.new();assert(Profile.claimDaily(p,200));assert(not Profile.claimDaily(p,200));assert(not Profile.claimDaily(p,199));equal(p.Crowns,25) end)
test("missing daily does not erase progress",function() local p=Profile.new();Profile.claimDaily(p,100);Profile.claimDaily(p,150);equal(p.Daily.Step,2);equal(p.Crowns,60) end)
test("daily cycles and owned cosmetic has deterministic compensation",function() local p=Profile.new();for day=1,14 do assert(Profile.claimDaily(p,day)) end;equal(p.Daily.Step,7);assert(p.OwnedCosmetics.ChaosTrail);assert(p.OwnedCosmetics.RoyalTitle);equal(p.Crowns,420) end)
test("quest claim needs target and only grants once",function() local p=Profile.new();assert(not Profile.claimQuest(p,"Qualify",100));for i=1,3 do Profile.grant(p,"q"..i,0,0,{Qualifications=1},100) end;assert(Profile.claimQuest(p,"Qualify",100));assert(not Profile.claimQuest(p,"Qualify",100));equal(p.Crowns,35) end)
test("UTC quest reset retains lifetime statistics",function() local p=Profile.new();Profile.grant(p,"q1",0,0,{Qualifications=1},100);Profile.grant(p,"q2",0,0,{PowerUses=1},101);equal(p.Quests.Counts.Qualify,nil);equal(p.Statistics.Qualifications,1) end)
test("settings validate whole update before applying",function() local p=Profile.new();assert(not Profile.settings(p,{SFX=0.1,Admin=true}));equal(p.Settings.SFX,0.7);assert(not Profile.settings(p,{Music=math.huge}));assert(Profile.settings(p,{ReducedParticles=true})) end)
test("unsupported future profile is not reset",function() local p,err=Profile.migrate({DataVersion=99,Crowns=400});assert(p==nil and err) end)
test("malformed critical currency is read-only",function() local p=Profile.migrate({DataVersion=1,Crowns=-1});equal(p,nil) end)
test("owned future cosmetic is preserved in migration",function() local p=Profile.migrate({DataVersion=1,OwnedCosmetics={FutureCape=true}});assert(p and p.OwnedCosmetics.FutureCape) end)
test("global and local wins are separate",function() local p=Profile.new();Profile.win(p,"local",false,2,100);equal(p.LocalWins,1);equal(p.Wins,0);equal(p.BestStreak,0);Profile.win(p,"global",true,5,100);equal(p.Wins,1);equal(p.BestStreak,5);assert(not Profile.win(p,"global",true,5,100)) end)
test("session read+lock atomic and competing owner refused",function() local a=Sessions.open(nil,"A",100,240);assert(a);local b=Sessions.open(a,"B",101,240);equal(b,nil) end)
test("expired owner cannot overwrite newer session",function() local a=Sessions.open(nil,"A",100,10);local b=Sessions.open(a,"B",111,10);assert(b);equal(Sessions.save(b,Profile.new(),"A",112,10,false),nil) end)
test("lock release still forbids former owner saving",function() local a=Sessions.open(nil,"A",100,10);local released=Sessions.save(a,a.Profile,"A",101,10,true);equal(Sessions.save(released,a.Profile,"A",102,10,false),nil) end)
test("saved candidate must not share mutable references",function() local a=Sessions.open(nil,"A",100,10);local candidate=Profile.new();local saved=Sessions.save(a,candidate,"A",101,10,false);candidate.Crowns=800;equal(saved.Profile.Crowns,0) end)
test("malformed lock and revision are rejected without exception",function()
    for _,lock in {false,"bad",{Owner="B"},{Owner="B",ExpiresAt=0/0}} do
        local ok,value,reason=pcall(Sessions.open,{Profile=Profile.new(),Lock=lock},"A",100,10)
        assert(ok and value==nil and reason)
    end
    equal(Sessions.open({Profile=Profile.new(),Revision="broken"},"A",100,10),nil)
    local a=Sessions.open(nil,"A",100,10);a.Revision=-1;equal(Sessions.save(a,a.Profile,"A",101,10,false),nil)
end)
test("unknown and spam action rate limited",function() local l=Limiter.new();assert(not l:allow(1,"GiveCurrency",1));assert(l:allow(1,"Power",1));assert(l:allow(1,"Power",1));assert(not l:allow(1,"Power",1));assert(l:allow(1,"Power",2)) end)
test("rate limiter cleanup and independent players",function() local l=Limiter.new();l:allow(1,"Daily",1);assert(not l:allow(1,"Daily",1));assert(l:allow(2,"Daily",1));l:clear(1);assert(l:allow(1,"Daily",1)) end)
test("remote accepts only defined payload schema",function() assert(Validator.valid({Action="Power"}));assert(not Validator.valid({Action="Power",Position={1,2,3}}));assert(not Validator.valid({Action="GiveCurrency",Amount=500}));assert(not Validator.valid({Action="Queue",Enabled="yes"}));assert(not Validator.valid({Action="Ready"})) end)
test("remote rejects NaN/nested settings/unknown fields",function() assert(not Validator.valid({Action="Settings",Settings={SFX=0/0}}));assert(not Validator.valid({Action="Settings",Settings={SFX={Value=0}}}));assert(not Validator.valid({Action="Settings",Settings={Admin=true}}));assert(Validator.valid({Action="Settings",Settings={SFX=0.25,LowEffects=true}})) end)
test("final cannot choose lethal map events",function() local tags={LowGravity=true,Neon=true,Meteors=true,Breaking=true,Falling=true};for _,id in Selection.eligible("Final",tags,16,{},1) do assert(id=="LowGravity" or id=="NeonMode") end end)
test("missing map tags leaves empty pool",function() equal(#Selection.eligible("Race",{},16,{},2),0);equal(Selection.choose("Race",{},16,{},2,{},function()return 0 end),nil) end)
test("incompatible events filtered both directions",function() local tags={LowGravity=true,Speed=true,Vanishing=true,Meteors=true,Falling=true,Breaking=true,Neon=true};local pool=Selection.eligible("Race",tags,16,{WorldBreaking=true},2);assert(not table.find(pool,"MeteorShower"));assert(not table.find(pool,"VanishingPlatforms"));assert(not table.find(pool,"FallingTiles")) end)
test("legendary respects minimum roster",function() assert(not table.find(Selection.eligible("Race",{Breaking=true},2,{},2),"WorldBreaking")) end)
test("rarity empty tiers renormalize without unsafe fallback",function() equal(Selection.choose("Final",{LowGravity=true},2,{},1,{},function()return 0.999999 end),"LowGravity") end)
test("history avoids repeats when alternative exists",function() equal(Selection.choose("Final",{LowGravity=true,Neon=true},2,{},1,{"LowGravity"},function()return 0 end),"NeonMode") end)
test("swept trigger detects fast legal crossing",function() assert(Util.sweptBox(R.Vector3.new(0,0,-20),R.Vector3.new(0,0,20),R.Vector3.new(5,5,2)));assert(not Util.sweptBox(R.Vector3.new(10,0,-20),R.Vector3.new(10,0,20),R.Vector3.new(5,5,2))) end)
test("level thresholds and values",function() equal(Rules.level(0),1);equal(Rules.level(149),1);equal(Rules.level(150),2);equal(Rules.level(350),3);local into,total=Rules.xpIntoLevel(360);equal(into,10);equal(total,250) end)
test("8-to-6-to-4-to-1 model integration and saved rewards",function()
    local profiles={};for id=1,8 do profiles[id]=Profile.new() end
    local race=Round.new("Race",{1,2,3,4,5,6,7,8},6,90)
    for id=1,6 do race:batch({},{id},40+id);Profile.grant(profiles[id],"m1:r1",50,15,{Qualifications=1},200) end
    equal(#race.Order,6)
    local survival=Round.new("Survival",race.Order,4,170);survival:batch({5,6},{},150);equal(#survival.Order,4)
    for _,id in survival.Order do Profile.grant(profiles[id],"m1:r2",50,15,{Qualifications=1},200);Profile.grant(profiles[id],"m1:final",75,20,{FinalsReached=1},200) end
    local final=Round.new("Final",survival.Order,1,270);final:batch({1,2,3},{},220);equal(final.Winner,4)
    Profile.win(profiles[4],"m1:win",true,1,200)
    local store=Sessions.open(nil,"serverA",200,240);store=Sessions.save(store,profiles[4],"serverA",201,240,true)
    local rejoin=Sessions.open(store,"serverB",202,240);equal(rejoin.Profile.Wins,1);equal(rejoin.Profile.Crowns,110);equal(rejoin.Profile.TotalXP,425)
    assert(not Profile.win(rejoin.Profile,"m1:win",true,1,200))
    -- New match fresh RoundModel is independent; old callbacks cannot alter it.
    local second=Round.new("Race",{1,2,3,4,5,6,7,8},6,400);race:batch({4},{8},320);equal(#second.Order,0)
end)
