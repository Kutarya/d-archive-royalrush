      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MatchRules</string>
          <string name="Source"><![CDATA[--!strict
local Rules = {}
local quotas = {
    [3] = {2}, [4] = {2}, [5] = {4,2}, [6] = {5,3}, [7] = {6,3},
    [8] = {6,4}, [9] = {7,5,3}, [10] = {8,5,3}, [11] = {9,6,4},
    [12] = {9,6,4}, [13] = {10,7,4}, [14] = {11,7,4}, [15] = {12,8,4}, [16] = {12,8,4},
}
function Rules.plan(count: number, solo: boolean?): {any}
    assert(count % 1 == 0 and count >= 1 and count <= 16, "Invalid roster")
    if count == 1 then
        assert(solo, "Public matches require two players")
        return { {Mode="Race",Quota=1,Duration=90}, {Mode="RisingDanger",Quota=1,Duration=60}, {Mode="Final",Quota=1,Duration=90} }
    end
    local plan = {}
    local durations = if count <= 4 then {75,0,0,75} elseif count <= 8 then {90,75,0,90} else {110,90,100,100}
    local targets = quotas[count] or {}
    for index, quota in targets do
        table.insert(plan, { Mode=({"Race","Survival","RisingDanger"})[index], Quota=quota, Duration=durations[index] })
    end
    table.insert(plan, { Mode="Final", Quota=1, Duration=if count==2 then 70 else durations[4] })
    return plan
end
function Rules.quota(target: number, living: number): number
    if living <= 1 then return living end
    return math.clamp(target, 1, living - 1)
end
function Rules.level(xp: number): number
    local level, threshold = 1, 150
    local remaining = math.max(0, math.min(xp, 100000000))
    while remaining >= threshold do
        remaining -= threshold
        level += 1
        threshold = 150 + (level - 1) * 50
    end
    return level
end
function Rules.xpIntoLevel(xp: number): (number, number)
    local level, remaining, threshold = 1, math.max(0,xp), 150
    while remaining >= threshold do remaining -= threshold; level += 1; threshold = 150 + (level-1)*50 end
    return remaining, threshold
end
return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ObstacleMotion</string>
          <string name="Source"><![CDATA[-- Shared deterministic motion. The server validates hazards; clients render
-- the same phase at native frame rate and supply grounded surface velocity.
local Motion={}
function Motion.sample(kind,base,elapsed,period,phase,distance)
    local rate=math.pi*2/(period or 7)
    local t=elapsed*rate+(phase or 0)
    local position=Vector3.zero
    local velocity=Vector3.zero
    local rotation=CFrame.identity
    if kind=="MovingPlatform" then
        position=Vector3.new(math.sin(t)*(distance or 4),0,0)
        velocity=Vector3.new(math.cos(t)*rate*(distance or 4),0,0)
    elseif kind=="Elevator" then
        position=Vector3.new(0,(math.sin(t)+1)*3,0)
        velocity=Vector3.new(0,math.cos(t)*rate*3,0)
    elseif kind=="Spinner" then rotation=CFrame.Angles(0,t,0)
    elseif kind=="RotatingBeam" then rotation=CFrame.Angles(0,t,0)
    elseif kind=="PushWall" then position=Vector3.new(-8*(math.sin(t)+1),0,0)
    elseif kind=="Crusher" then position=Vector3.new(-9*(math.sin(t)+1),math.cos(t)*2,0)
    elseif kind=="SwingHammer" then position=Vector3.new(math.sin(t)*12,math.abs(math.sin(t))*3,0)
    elseif kind=="RollingBall" then position=Vector3.new(math.sin(t)*12,0,0);rotation=CFrame.Angles(0,0,t)
    end
    return base*CFrame.new(position)*rotation,base:VectorToWorldSpace(velocity),math.sin(t)>0.25
end
return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Profile</string>
          <string name="Source"><![CDATA[--!strict
local Config = if script then require(script.Parent.Config) else require("./Config")
local Util = if script then require(script.Parent.Util) else require("./Util")
local Profile = {}
local stats = {"RoundsPlayed","Qualifications","FinalsReached","Perfects","Clutches","PowerUses","ChaosSurvived"}
function Profile.new(): any
    local statistics = {}
    for _, key in stats do statistics[key]=0 end
    return {
        DataVersion=1,TotalXP=0,Wins=0,LocalWins=0,Crowns=0,BestStreak=0,
        SelectedPower="Dash",OwnedCosmetics={RookieTitle=true},EquippedCosmetics={Title="RookieTitle"},
        Settings=Util.copy(Config.Settings),Statistics=statistics,Achievements={},
        Daily={LastDay=-1,Step=0},Quests={Day=-1,Counts={},Claimed={}},
        Ledger={Keys={},Order={}},TutorialVersion=0,
    }
end
function Profile.migrate(raw: any): (any?, string?)
    if type(raw) ~= "table" then return nil,"Invalid profile" end
    if raw.DataVersion ~= nil and raw.DataVersion ~= 1 then return nil,"Unsupported data version" end
    local result = Profile.new()
    for _, key in {"TotalXP","Wins","LocalWins","Crowns","BestStreak"} do
        if raw[key] ~= nil and not Util.integer(raw[key],0,100000000) then return nil,"Invalid "..key end
        result[key]=raw[key] or 0
    end
    if Config.Powers[raw.SelectedPower] then result.SelectedPower=raw.SelectedPower end
    if type(raw.OwnedCosmetics)=="table" then
        for id,owned in raw.OwnedCosmetics do
            if type(id)=="string" and #id<=64 and owned==true then result.OwnedCosmetics[id]=true end
        end
    end
    if type(raw.EquippedCosmetics)=="table" then
        for kind,id in raw.EquippedCosmetics do
            local item=Config.Cosmetics[id]
            if item and item.Kind==kind and result.OwnedCosmetics[id] then result.EquippedCosmetics[kind]=id end
        end
    end
    if type(raw.Settings)=="table" then Profile.settings(result,raw.Settings) end
    if type(raw.Statistics)=="table" then
        for _,key in stats do if Util.integer(raw.Statistics[key],0,100000000) then result.Statistics[key]=raw.Statistics[key] end end
    end
    if type(raw.Achievements)=="table" then
        for key,value in raw.Achievements do if type(key)=="string" and #key<64 and value==true then result.Achievements[key]=true end end
    end
    if type(raw.Daily)=="table" and Util.integer(raw.Daily.LastDay,-1,1000000) and Util.integer(raw.Daily.Step,0,7) then result.Daily=Util.copy(raw.Daily) end
    if type(raw.Quests)=="table" and Util.integer(raw.Quests.Day,-1,1000000) then
        result.Quests.Day=raw.Quests.Day
        for _,quest in Config.Quests do
            if type(raw.Quests.Counts)=="table" and Util.integer(raw.Quests.Counts[quest.Id],0,1000000) then result.Quests.Counts[quest.Id]=raw.Quests.Counts[quest.Id] end
            if type(raw.Quests.Claimed)=="table" and raw.Quests.Claimed[quest.Id]==true then result.Quests.Claimed[quest.Id]=true end
        end
    end
    if type(raw.Ledger)=="table" and type(raw.Ledger.Order)=="table" then
        for _,id in raw.Ledger.Order do
            if type(id)=="string" and #id<=180 and not result.Ledger.Keys[id] then
                result.Ledger.Keys[id]=true;table.insert(result.Ledger.Order,id)
            end
        end
        while #result.Ledger.Order>256 do result.Ledger.Keys[table.remove(result.Ledger.Order,1)]=nil end
    end
    result.TutorialVersion=if Util.integer(raw.TutorialVersion,0,100) then raw.TutorialVersion else 0
    return result,nil
end
function Profile.settings(profile: any, settings: any): (boolean,string)
    if type(settings)~="table" then return false,"Invalid settings" end
    for key,value in settings do
        local default=Config.Settings[key]
        if default==nil then return false,"Unknown setting" end
        if type(default)=="number" then
            if not Util.finite(value) or value<0 or value>1 then return false,"Invalid volume" end
        elseif type(value)~="boolean" then return false,"Invalid setting" end
    end
    for key,value in settings do profile.Settings[key]=value end
    return true,"Settings saved"
end
function Profile.day(profile: any, day: number)
    if day>profile.Quests.Day then profile.Quests={Day=day,Counts={},Claimed={}} end
end
function Profile.remember(profile: any, id: string): boolean
    if profile.Ledger.Keys[id] then return false end
    profile.Ledger.Keys[id]=true;table.insert(profile.Ledger.Order,id)
    if #profile.Ledger.Order>256 then profile.Ledger.Keys[table.remove(profile.Ledger.Order,1)]=nil end
    return true
end
function Profile.grant(profile: any, id: string, xp: number, crowns: number, increments: any?, day: number): (boolean,string)
    if not Util.integer(xp,0,100000) or not Util.integer(crowns,0,100000) then return false,"Invalid reward" end
    if not Profile.remember(profile,id) then return false,"Duplicate" end
    Profile.day(profile,day)
    profile.TotalXP=math.min(100000000,profile.TotalXP+xp)
    profile.Crowns=math.min(100000000,profile.Crowns+crowns)
    for key,amount in increments or {} do
        if profile.Statistics[key]~=nil and Util.integer(amount,0,1000) then
            profile.Statistics[key]+=amount
            for _,quest in Config.Quests do
                if quest.Statistic==key then profile.Quests.Counts[quest.Id]=math.min(quest.Target,(profile.Quests.Counts[quest.Id] or 0)+amount) end
            end
        end
    end
    if profile.Statistics.Qualifications>0 then profile.Achievements.FirstQualification=true end
    if profile.Statistics.FinalsReached>0 then profile.Achievements.FirstFinal=true end
    if profile.Statistics.Perfects>0 then profile.Achievements.Perfect=true end
    if profile.Statistics.Clutches>0 then profile.Achievements.Clutch=true end
    return true,"Reward granted"
end
function Profile.win(profile: any, id: string, competitive: boolean, streak: number, day: number): (boolean,string)
    local ok,reason=Profile.grant(profile,id,if competitive then 250 else 100,if competitive then 60 else 20,nil,day)
    if not ok then return ok,reason end
    if competitive then
        profile.Wins+=1;profile.BestStreak=math.max(profile.BestStreak,streak)
        if profile.Wins>=10 then profile.Achievements.TenWins=true end
        if streak>=5 then profile.Achievements.FiveStreak=true end
    else profile.LocalWins+=1 end
    profile.Achievements.FirstCrown=true
    return true,"Crown won"
end
function Profile.buy(profile: any, id: string): (boolean,string)
    local item=Config.Cosmetics[id]
    if not item then return false,"Unknown cosmetic" end
    if profile.OwnedCosmetics[id] then return false,"Already owned" end
    if profile.Crowns<item.Price then return false,"Not enough Crowns" end
    profile.Crowns-=item.Price;profile.OwnedCosmetics[id]=true;profile.EquippedCosmetics[item.Kind]=id
    return true,"Purchased "..item.Name
end
function Profile.equip(profile: any, id: string): (boolean,string)
    local item=Config.Cosmetics[id]
    if not item or not profile.OwnedCosmetics[id] then return false,"Not owned" end
    profile.EquippedCosmetics[item.Kind]=id
    return true,"Equipped "..item.Name
end
function Profile.claimDaily(profile: any, day: number): (boolean,string)
    if day<=profile.Daily.LastDay then return false,"Already claimed today" end
    local step=profile.Daily.Step%7+1
    local reward=Config.Daily[step]
    local crowns=reward.Crowns or 0
    if reward.Cosmetic then
        if profile.OwnedCosmetics[reward.Cosmetic] then crowns+=30 else profile.OwnedCosmetics[reward.Cosmetic]=true end
    end
    profile.Crowns+=crowns;profile.TotalXP+=reward.XP or 0
    profile.Daily={LastDay=day,Step=step}
    return true,"Day "..step.." reward claimed"
end
function Profile.claimQuest(profile: any, id: string, day: number): (boolean,string)
    Profile.day(profile,day)
    for _,quest in Config.Quests do
        if quest.Id==id then
            if profile.Quests.Claimed[id] then return false,"Already claimed" end
            if (profile.Quests.Counts[id] or 0)<quest.Target then return false,"Quest incomplete" end
            profile.Quests.Claimed[id]=true
            profile.TotalXP+=quest.XP;profile.Crowns+=quest.Crowns
            return true,"Quest reward claimed"
        end
    end
    return false,"Unknown quest"
end
return Profile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict
local Limits={Power={2,2},Sync={1,2},Ready={2,2},Queue={1,2},Lobby={0.5,1},Loadout={1,2},Buy={0.5,2},Equip={1,2},Daily={0.5,1},Quest={0.5,2},Settings={1,2},Tutorial={0.5,1}}
local Limiter={}
Limiter.__index=Limiter
function Limiter.new() return setmetatable({Players={}},Limiter) end
function Limiter:allow(id: number,action: string,now: number): boolean
    local limit=Limits[action]
    if not limit then return false end
    local player=self.Players[id]
    if not player then player={Global={Tokens=12,Time=now},Actions={}};self.Players[id]=player end
    local global=player.Global
    global.Tokens=math.min(12,global.Tokens+math.max(0,now-global.Time)*6);global.Time=now
    local bucket=player.Actions[action] or {Tokens=limit[2],Time=now}
    player.Actions[action]=bucket
    bucket.Tokens=math.min(limit[2],bucket.Tokens+math.max(0,now-bucket.Time)*limit[1]);bucket.Time=now
    if global.Tokens<1 or bucket.Tokens<1 then return false end
    global.Tokens-=1;bucket.Tokens-=1
    return true
end
function Limiter:clear(id: number) self.Players[id]=nil end
return Limiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">RequestValidation</string>
          <string name="Source"><![CDATA[--!strict
local Util=if script then require(script.Parent.Util) else require("./Util")
local Config=if script then require(script.Parent.Config) else require("./Config")
local schemas={Sync={},Power={},Ready={RoundId="string"},Queue={Enabled="boolean"},Lobby={},Loadout={Id="string"},Buy={Id="string"},Equip={Id="string"},Daily={},Quest={Id="string"},Settings={Settings="table"},Tutorial={}}
local Validator={}
function Validator.valid(payload: any): boolean
    if type(payload)~="table" or type(payload.Action)~="string" then return false end
    local schema=schemas[payload.Action]
    if not schema then return false end
    local count=0
    for key,value in payload do
        count+=1;if count>3 or type(key)~="string" then return false end
        if key~="Action" then
            local expected=schema[key]
            if not expected or type(value)~=expected then return false end
            if expected=="string" and (#value<1 or #value>160) then return false end
        end
    end
    for key in schema do if payload[key]==nil then return false end end
    if payload.Settings then
        local n=0
        for key,value in payload.Settings do
            n+=1;local default=Config.Settings[key]
            if n>7 or default==nil or type(value)~=type(default) then return false end
            if type(value)=="number" and (not Util.finite(value) or value<0 or value>1) then return false end
        end
        if n==0 then return false end
    end
    return true
end
return Validator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">RoundModel</string>
          <string name="Source"><![CDATA[--!strict
local Round = {}
Round.__index = Round
function Round.new(mode: string, ids: {number}, quota: number, deadline: number, solo: boolean?)
    local self = setmetatable({Mode=mode,Quota=quota,Deadline=deadline,Alive={},Qualified={},Order={},Placements={},Ties={},Done=false,Overtime=false,Reason="",Solo=solo==true,Winner=nil,Draw=false},Round)
    for _, id in ids do self.Alive[id] = true end
    return self
end
function Round:count(): number
    local count = 0
    for _, living in self.Alive do if living then count += 1 end end
    return count
end
function Round:living(): {number}
    local ids = {}
    for id, alive in self.Alive do if alive then table.insert(ids,id) end end
    table.sort(ids)
    return ids
end
function Round:batch(deaths: {number}, finishes: {number}, now: number)
    if self.Done then return end
    -- Resolve a complete server sample before deciding winner; callback order is irrelevant.
    for _, id in deaths do self.Alive[id] = nil end
    local accepted = {}
    if now <= self.Deadline then
        for _, id in finishes do
            if self.Alive[id] and not self.Qualified[id] then self.Qualified[id]=true; table.insert(accepted,id) end
        end
    end
    table.sort(accepted)
    local placement=#self.Order+1
    for _, id in accepted do self.Placements[id]=placement;self.Ties[id]=#accepted>1;table.insert(self.Order,id) end
    if self.Mode == "Final" then
        if #accepted > 1 then self.Done=true; self.Draw=true; self.Reason="Crown tie"
        elseif #accepted == 1 then self.Done=true; self.Winner=accepted[1]; self.Reason="Crown reached"
        elseif self:count() == 0 then self.Done=true; self.Draw=true; self.Reason="Nobody survived"
        elseif self:count() == 1 and not self.Solo then self.Done=true; self.Winner=self:living()[1]; self.Reason="Last survivor" end
    elseif self.Mode == "Race" then
        if #self.Order >= self.Quota then self.Done=true; self.Reason="Quota reached"
        elseif self:count() == 0 then self.Done=true; self.Reason="No participants" end
    elseif self:count() == 0 then self.Done=true; self.Draw=true; self.Reason="Nobody survived"
    elseif self:count() <= self.Quota and not self.Solo then self:qualifyLiving(); self.Done=true; self.Reason="Survived" end
end
function Round:qualifyLiving()
    for _, id in self:living() do
        if not self.Qualified[id] then self.Qualified[id]=true; table.insert(self.Order,id) end
    end
end
function Round:expire(now: number, overtimeSeconds: number): string
    if self.Done or now < self.Deadline then return "None" end
    if self.Mode == "Race" then self.Done=true; self.Reason="Time up"; return "Ended" end
    if not self.Overtime then self.Overtime=true; self.Deadline=now+overtimeSeconds; return "Overtime" end
    self.Done=true
    if self.Mode == "Final" then self.Draw=true; self.Reason="Time up: draw"
    else self:qualifyLiving(); self.Reason="All remaining survived" end
    return "Ended"
end
return Round
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">SessionStore</string>
          <string name="Source"><![CDATA[--!strict
local Profile=if script then require(script.Parent.Profile) else require("./Profile")
local Util=if script then require(script.Parent.Util) else require("./Util")
local Store={}
local function revision(old: any): number?
    local value=if old then old.Revision else nil
    if value==nil then return 0 end
    if not Util.finite(value) or value<0 or value%1~=0 then return nil end
    return value
end
function Store.open(old: any,owner: string,now: number,ttl: number): (any?,string?)
    if old~=nil and type(old)~="table" then return nil,"Malformed stored record" end
    if old and old.Lock~=nil then
        if type(old.Lock)~="table" or type(old.Lock.Owner)~="string" or not Util.finite(old.Lock.ExpiresAt) then return nil,"Malformed session lock" end
        if old.Lock.Owner~=owner and old.Lock.ExpiresAt>now then return nil,"Profile locked by another server" end
    end
    local rev=revision(old);if not rev then return nil,"Malformed record revision" end
    local raw=if old then (old.Profile or old) else Profile.new()
    local profile,reason=Profile.migrate(raw)
    if not profile then return nil,reason end
    return {Profile=profile,Lock={Owner=owner,ExpiresAt=now+ttl},Revision=rev},nil
end
function Store.save(old: any,profile: any,owner: string,now: number,ttl: number,release: boolean): (any?,string?)
    if type(old)~="table" or type(old.Lock)~="table" or old.Lock.Owner~=owner then return nil,"Session ownership lost" end
    local rev=revision(old);if not rev then return nil,"Malformed record revision" end
    return {Profile=Util.copy(profile),Lock=if release then nil else {Owner=owner,ExpiresAt=now+ttl},Revision=rev+1},nil
end
return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
