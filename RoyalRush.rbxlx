      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ChaosService</string>
          <string name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.RoyalRush.Config)
local Selection=require(RS.RoyalRush.ChaosSelection)
local Power=require(script.Parent.PowerService)
local Chaos={};Chaos.__index=Chaos
function Chaos.new(map,context)
    return setmetatable({Map=map,Context=context,Current=nil,Pending=nil,Meteors={},History={},Neon={},ForceRoots={}},Chaos)
end
function Chaos:startRound(mode,index,seed,start)
    self:stop();self.Mode=mode;self.Index=index;self.RNG=Random.new(seed);self.Started=start;self.Token=self.Context:roundToken()
    self.NextAt=start+(if index==1 and mode=="Race" then 27 else 20)
    self.Remaining=if mode=="Final" or index==1 then 1 else 2
end
function Chaos:_effect(name,data) self.Context:effect(name,data) end
function Chaos:_modifier(record,active)
    if record.Status~="Active" then active=false end
    if record.Humanoid then record.Humanoid.WalkSpeed=if active and self.Current and self.Current.Id=="SuperSpeed" then Config.WalkSpeed*1.15 else Config.WalkSpeed end
    local root=record.Root
    if root and root.Parent then
        local force=root:FindFirstChild("RoyalLowGravity")
        local enabled=active and self.Current and self.Current.Id=="LowGravity"
        if enabled and not force then
            local attachment=Instance.new("Attachment");attachment.Name="RoyalGravityAttachment";attachment.Parent=root
            force=Instance.new("VectorForce");force.Name="RoyalLowGravity";force.Attachment0=attachment;force.RelativeTo=Enum.ActuatorRelativeTo.World;force.ApplyAtCenterOfMass=true;force.Parent=root;self.ForceRoots[root]=true
        end
        if enabled and force then force.Force=Vector3.new(0,root.AssemblyMass*workspace.Gravity*0.35,0)
        elseif force then force:Destroy();local a=root:FindFirstChild("RoyalGravityAttachment");if a then a:Destroy() end;self.ForceRoots[root]=nil end
    end
end
function Chaos:clearCharacter(record)
    self:_modifier(record,false)
    Power.clearShield(record)
    if record.Root then
        for _,name in {"RoyalDash","RoyalDashAttachment","RoyalLowGravity","RoyalGravityAttachment"} do local p=record.Root:FindFirstChild(name);if p then p:Destroy() end end
    end
end
function Chaos:_begin(id,now)
    local event=Config.Events[id]
    self.Current={Id=id,Name=event.Name,Ends=now+event.Duration,Started=now,NextHazard=now+1}
    table.insert(self.History,id);if #self.History>2 then table.remove(self.History,1) end
    if id=="VanishingPlatforms" or id=="FallingTiles" or id=="WorldBreaking" then self.Map:setEvent(id,now) end
    if id=="NeonMode" then
        for _,p in self.Map.Model.Decoration:GetDescendants() do
            if p:IsA("BasePart") and p.Transparency<1 then self.Neon[p]={Color=p.Color,Material=p.Material};p.Material=Enum.Material.Neon end
        end
    end
    self:_effect("ChaosStart",{Id=id,Name=event.Name,Ends=self.Current.Ends})
end
function Chaos:_end(now)
    local current=self.Current
    if current then
        if now>=current.Ends and Config.Events[current.Id].Cost>0 then
            for _,record in self.Context.Records do
                if record.Status=="Active" and (record.ActiveSeconds or 0)>=3 then self.Context:stat(record,"ChaosSurvived",self.Token..":chaos:"..current.Id..":"..current.Started) end
            end
        end
        self:_effect("ChaosEnd",{Id=current.Id})
    end
    self.Current=nil;self.Meteors={};self.Map:setEvent(nil,now)
    for part,saved in self.Neon do if part.Parent then part.Color=saved.Color;part.Material=saved.Material end end
    self.Neon={}
    for _,record in self.Context.Records do self:_modifier(record,false) end
end
function Chaos:update(now)
    if self.Token~=self.Context:roundToken() then self:stop();return end
    if self.Pending and now>=self.Pending.Starts then local id=self.Pending.Id;self.Pending=nil;self:_begin(id,now) end
    local current=self.Current
    if current and now>=current.Ends then self:_end(now);self.NextAt=now+6;current=nil end
    if not current and not self.Pending and self.Remaining>0 and now>=self.NextAt then
        local id=if self.Index==1 and self.Mode=="Race" and self.Context.MatchNumber==1 then "LowGravity" else Selection.choose(self.Mode,self.Map.Info.Tags,self.Context:activeCount(),{},if self.Mode=="Final" then 1 else 2,self.History,function() return self.RNG:NextNumber() end)
        self.Remaining-=1
        if id then self.Pending={Id=id,Starts=now+3};self:_effect("ChaosWarning",{Name=Config.Events[id].Name,Starts=now+3}) end
    end
    for _,record in self.Context.Records do if record.Status=="Active" then self:_modifier(record,true) end end
    if not current then return end
    if current.Id=="MeteorShower" and now>=current.NextHazard then
        current.NextHazard=now+2.5
        local targets=self.Map:meteorTargets()
        if #targets>0 then
            local position=targets[self.RNG:NextInteger(1,#targets)]
            local meteor={Position=position,Hits=now+2.2,Radius=5}
            table.insert(self.Meteors,meteor);self:_effect("MeteorWarning",meteor)
        end
    elseif current.Id=="Shockwave" and now>=current.NextHazard then
        current.NextHazard=now+5
        local center=self.Map.Model.PrimaryPart.Position+Vector3.new(0,2,0)
        self.Shock={Center=center,Hits=now+2,Warned=true}
        self:_effect("ShockwaveWarning",{Position=center,Hits=now+2,Radius=55})
    end
    for index=#self.Meteors,1,-1 do
        local meteor=self.Meteors[index]
        if now>=meteor.Hits then
            for _,record in self.Context.Records do
                if record.Status=="Active" and record.Root then
                    local delta=record.Root.Position-meteor.Position
                    if Vector2.new(delta.X,delta.Z).Magnitude<=meteor.Radius+1 and math.abs(delta.Y)<=7 then self.Context:queueDeath(record,"Meteor") end
                end
            end
            self:_effect("MeteorHit",meteor);table.remove(self.Meteors,index)
        end
    end
    if self.Shock and now>=self.Shock.Hits then
        for _,record in self.Context.Records do
            if record.Status=="Active" and record.Root and record.Humanoid.FloorMaterial~=Enum.Material.Air and (record.Root.Position-self.Shock.Center).Magnitude<60 then Power.knock(record,self.Shock.Center,now) end
        end
        self:_effect("ShockwaveHit",{Position=self.Shock.Center});self.Shock=nil
    end
end
function Chaos:stop()
    self.Pending=nil;self.Remaining=0;self.Shock=nil;self:_end(workspace:GetServerTimeNow())
    for root in self.ForceRoots do
        if root.Parent then for _,name in {"RoyalLowGravity","RoyalGravityAttachment"} do local p=root:FindFirstChild(name);if p then p:Destroy() end end end
    end
    self.ForceRoots={};self.Token=nil
end
function Chaos:view()
    if self.Pending then return {Name="CHAOS INCOMING",Next=self.Pending.Starts,Id=self.Pending.Id} end
    if self.Current then return {Name=self.Current.Name,Ends=self.Current.Ends,Id=self.Current.Id} end
    return nil
end
return Chaos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.RoyalRush.Config)
local Cosmetics={}
function Cosmetics.apply(character,profile,streak)
    Cosmetics.clearAttachments(character)
    local old=character:FindFirstChild("RoyalCosmetics");if old then old:Destroy() end
    local folder=Instance.new("Folder");folder.Name="RoyalCosmetics";folder.Parent=character
    local root=character:FindFirstChild("HumanoidRootPart");local head=character:FindFirstChild("Head")
    if not root then return end
    for kind,id in profile.EquippedCosmetics do
        local item=Config.Cosmetics[id]
        if item and profile.OwnedCosmetics[id] then
            if kind=="Trail" then
                local a=Instance.new("Attachment");a.Position=Vector3.new(0,0.6,0.8);a.Parent=root
                local b=Instance.new("Attachment");b.Position=Vector3.new(0,-0.6,0.8);b.Parent=root
                a.Name="RoyalTrailA";b.Name="RoyalTrailB"
                local trail=Instance.new("Trail");trail.Attachment0=a;trail.Attachment1=b;trail.Lifetime=0.3;trail.MinLength=0.15;trail.Color=ColorSequence.new(Color3.fromRGB(unpack(item.Color)));trail.Transparency=NumberSequence.new(0.3,1);trail.Parent=folder
            elseif kind=="Aura" then
                local highlight=Instance.new("Highlight");highlight.Adornee=character;highlight.FillTransparency=1;highlight.OutlineTransparency=0.55;highlight.OutlineColor=Color3.fromRGB(unpack(item.Color));highlight.Parent=folder
            elseif kind=="Title" and head then
                local gui=Instance.new("BillboardGui");gui.Size=UDim2.fromOffset(190,30);gui.StudsOffset=Vector3.new(0,2.2,0);gui.Adornee=head;gui.MaxDistance=100;gui.Parent=folder
                local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text=item.Name..(if streak>0 then "  • "..streak.." STREAK" else "");text.Font=Enum.Font.GothamBold;text.TextSize=13;text.TextColor3=Color3.fromRGB(255,214,88);text.TextStrokeTransparency=0.5;text.Parent=gui
            end
        end
    end
end
function Cosmetics.clearAttachments(character)
    local root=character and character:FindFirstChild("HumanoidRootPart")
    if root then for _,p in root:GetChildren() do if p.Name=="RoyalTrailA" or p.Name=="RoyalTrailB" then p:Destroy() end end end
end
return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local DataStoreService=game:GetService("DataStoreService")
local Shared=RS:WaitForChild("RoyalRush")
local Config=require(Shared.Config)
local Profile=require(Shared.Profile)
local Sessions=require(Shared.SessionStore)
local Util=require(Shared.Util)
local Rules=require(Shared.MatchRules)
local Data={};Data.__index=Data
function Data.new(changed)
    local memory=RunService:IsStudio() and not Config.Persistence.StudioCloud
    local store=nil
    if not memory then local ok,value=pcall(function() return DataStoreService:GetDataStore(Config.Persistence.Store) end);if ok then store=value end end
    return setmetatable({Entries={},Memory={},Changed=changed,MemoryMode=memory,Store=store,Closed=false},Data)
end
function Data:_retry(callback)
    local last="Storage unavailable"
    for attempt=1,Config.Persistence.Attempts do
        local ok,result,reason=pcall(callback)
        if ok and result then return result end
        last=if ok then (reason or last) else tostring(result)
        if attempt<Config.Persistence.Attempts then task.wait(0.5*2^(attempt-1)) end
    end
    return nil,last
end
function Data:load(player)
    local entry={Player=player,Queue={},Busy=false,Closing=false,Profile=Profile.new(),Revision=0,Status="Loading",Mutable=false,Dirty=false,Owner=HttpService:GenerateGUID(false)}
    self.Entries[player.UserId]=entry
    if self.MemoryMode then
        entry.Profile=Util.copy(self.Memory[player.UserId] or Profile.new());entry.Status="Studio memory";entry.Mutable=true
    else
        local result,reason=self:_retry(function()
            local abort
            local value=self.Store:UpdateAsync("player:"..player.UserId,function(old)
                local nextValue,message=Sessions.open(old,entry.Owner,os.time(),Config.Persistence.LockSeconds)
                abort=message;return nextValue
            end)
            return value,abort
        end)
        if result then entry.Profile=result.Profile;entry.Status="Saved";entry.Mutable=true
        else entry.Status="Read only: "..tostring(reason);warn("[Royal Rush] Profile unavailable; defaults will NOT overwrite stored data.") end
    end
    entry.Revision+=1
    self:_notify(player)
    if entry.Closing then self:remove(player) end
end
function Data:get(player) return self.Entries[player.UserId] end
function Data:_notify(player)
    local ok,reason=pcall(self.Changed,player)
    if not ok then warn("[Royal Rush] Profile observer failed: "..tostring(reason)) end
end
function Data:_save(entry,candidate,release)
    if self.MemoryMode then self.Memory[entry.Player.UserId]=Util.copy(candidate);return true end
    local value,reason=self:_retry(function()
        local abort
        local result=self.Store:UpdateAsync("player:"..entry.Player.UserId,function(old)
            local nextValue,message=Sessions.save(old,candidate,entry.Owner,os.time(),Config.Persistence.LockSeconds,release==true)
            abort=message;return nextValue
        end)
        return result,abort
    end)
    if not value and reason=="Session ownership lost" then entry.Mutable=false;entry.Status="Read only: session ownership lost" end
    return value~=nil,reason
end
function Data:submit(player,operation,mustSave,completed)
    local entry=self:get(player)
    if not entry or not entry.Mutable or entry.Closing then if completed then completed(false,"Progress is not available") end;return end
    if #entry.Queue>=32 then if completed then completed(false,"Profile is busy; try again shortly") end;return end
    table.insert(entry.Queue,{Operation=operation,Save=mustSave,Completed=completed})
    if entry.Busy then return end
    entry.Busy=true
    task.spawn(function()
        while #entry.Queue>0 do
            local job=table.remove(entry.Queue,1)
            local candidate=Util.copy(entry.Profile)
            local protected,ok,message=true,false,"Progress is not available"
            if entry.Mutable then protected,ok,message=pcall(job.Operation,candidate,math.floor(os.time()/86400)) end
            if not protected then local failure=ok;ok=false;message="Profile operation failed";warn("[Royal Rush] "..tostring(failure)) end
            if ok and job.Save then
                local saved,reason=self:_save(entry,candidate,false)
                if not saved then ok=false;message="Save failed; transaction not committed";if entry.Mutable then entry.Status="Save failed" end;warn("[Royal Rush] "..tostring(reason)) end
            end
            if ok then
                entry.Profile=candidate;entry.Dirty=not job.Save;entry.Revision+=1
                entry.Status=if self.MemoryMode then "Studio memory" elseif job.Save then "Saved" else "Pending save"
                self:_notify(player)
            end
            if job.Completed then local success,err=pcall(job.Completed,ok,message);if not success then warn(err) end end
        end
        entry.Busy=false
    end)
end
function Data:autosave()
    for _,entry in self.Entries do
        if entry.Mutable and not entry.Closing and not entry.Busy then
            self:submit(entry.Player,function(_) return true,"Autosave" end,true)
        end
    end
end
function Data:remove(player)
    local entry=self:get(player)
    if not entry or entry.Removing then return end
    entry.Closing=true
    if entry.Status=="Loading" then return end
    entry.Removing=true
    task.spawn(function()
        local deadline=os.clock()+20
        while entry.Busy and os.clock()<deadline do task.wait(0.1) end
        if entry.Busy then warn("[Royal Rush] Pending profile operations at shutdown; last unsaved changes may be lost.")
        elseif entry.Mutable then
            local ok,reason=self:_save(entry,entry.Profile,true)
            if not ok then warn("[Royal Rush] Final save failed: "..tostring(reason)) end
        end
        if self.Entries[player.UserId]==entry then self.Entries[player.UserId]=nil end
    end)
end
function Data:view(player)
    local entry=self:get(player)
    if not entry then return {Ready=false,SaveStatus="Loading"} end
    local p=entry.Profile
    local quests=Util.copy(p.Quests);local day=math.floor(os.time()/86400)
    if day>quests.Day then quests={Day=day,Counts={},Claimed={}} end
    return {Ready=entry.Status~="Loading",Mutable=entry.Mutable,Persistent=not self.MemoryMode and entry.Mutable,
        SaveStatus=entry.Status,Revision=entry.Revision,Level=Rules.level(p.TotalXP),XP=p.TotalXP,Crowns=p.Crowns,Wins=p.Wins,LocalWins=p.LocalWins,BestStreak=p.BestStreak,
        SelectedPower=p.SelectedPower,OwnedCosmetics=Util.copy(p.OwnedCosmetics),EquippedCosmetics=Util.copy(p.EquippedCosmetics),Settings=Util.copy(p.Settings),
        Quests=quests,Daily=Util.copy(p.Daily),Day=day,TutorialVersion=p.TutorialVersion,Achievements=Util.copy(p.Achievements)}
end
function Data:close()
    self.Closed=true
    for _,entry in self.Entries do self:remove(entry.Player) end
    local untilTime=os.clock()+25
    while next(self.Entries) and os.clock()<untilTime do task.wait(0.1) end
end
return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local PhysicsService=game:GetService("PhysicsService")
local HttpService=game:GetService("HttpService")
local Shared=RS:WaitForChild("RoyalRush")
local Config=require(Shared.Config)
local Rules=require(Shared.MatchRules)
local RoundModel=require(Shared.RoundModel)
local Profile=require(Shared.Profile)
local Util=require(Shared.Util)
local RateLimiter=require(Shared.RateLimiter)
local RequestValidation=require(Shared.RequestValidation)
local DataService=require(script.Parent.DataService)
local MapService=require(script.Parent.MapService)
local ChaosService=require(script.Parent.ChaosService)
local Power=require(script.Parent.PowerService)
local Cosmetics=require(script.Parent.CosmeticService)
local LobbyService=require(script.Parent.LobbyService)
local Analytics=require(script.Parent.Analytics)
local Game={};Game.__index=Game
local activeStates={RoundActive=true,Final=true}
local function newRemote(parent,name)
    local event=Instance.new("RemoteEvent");event.Name=name;event.Parent=parent;return event
end
function Game.new()
    local network=Instance.new("Folder");network.Name="RoyalRushRemotes";network.Parent=RS
    local self=setmetatable({Records={},Roster={},State="Waiting",Deadline=0,StateVersion=0,RoundIndex=0,RoundId="",MatchId="",MatchNumber=0,PendingDeaths={},Limiter=RateLimiter.new(),Connections={},NextSnapshot=0,LastSave=0,LastBoard=0,Stopped=false,Result=nil},Game)
    self.Remotes={Action=newRemote(network,"Action"),State=newRemote(network,"State"),Effect=newRemote(network,"Effect")}
    self.Map=MapService.new();self.Lobby=LobbyService.new()
    self.Data=DataService.new(function(player) self:onData(player) end)
    self.Chaos=ChaosService.new(self.Map,self)
    pcall(function() PhysicsService:RegisterCollisionGroup("RoyalPlayers") end)
    PhysicsService:CollisionGroupSetCollidable("RoyalPlayers","RoyalPlayers",false)
    return self
end
function Game:roundToken() return self.RoundId end
function Game:effect(name,data,player)
    if player and player.Parent then self.Remotes.Effect:FireClient(player,name,data)
    elseif not player then self.Remotes.Effect:FireAllClients(name,data) end
end
function Game:toast(player,message) self:effect("Toast",{Text=message},player) end
function Game:onData(player)
    local record=self.Records[player.UserId];local entry=self.Data:get(player)
    if record and entry then
        if not table.find(self.Roster,player.UserId) or self.State=="Waiting" or self.State=="Intermission" or self.State=="Results" then record.LockedPower=entry.Profile.SelectedPower end
        if record.Character and record.Character.Parent then Cosmetics.apply(record.Character,entry.Profile,record.Streak) end
        self.Lobby:publish(player,entry);self:send(player)
    end
end
function Game:state(name,seconds)
    self.State=name;self.StateVersion+=1;self.Deadline=workspace:GetServerTimeNow()+(seconds or 0)
    print("[Royal Rush] "..name.." • round "..self.RoundIndex)
    self:broadcast()
end
function Game:character(record,character)
    if record.CharacterConnection then record.CharacterConnection:Disconnect() end
    record.Character=character;record.Humanoid=character:WaitForChild("Humanoid",10);record.Root=character:WaitForChild("HumanoidRootPart",10)
    if not record.Humanoid or not record.Root then return end
    if not record.Humanoid:FindFirstChildOfClass("Animator") then Instance.new("Animator",record.Humanoid) end
    record.Humanoid.UseJumpPower=false;record.Humanoid.JumpHeight=Config.JumpHeight
    for _,p in character:GetDescendants() do
        if p:IsA("BasePart") then p.CollisionGroup="RoyalPlayers" end
        if p:IsA("NumberValue") and ({BodyHeightScale=true,BodyWidthScale=true,BodyDepthScale=true,HeadScale=true})[p.Name] then p.Value=1 end
    end
    if record.DescendantConnection then record.DescendantConnection:Disconnect() end
    record.DescendantConnection=character.DescendantAdded:Connect(function(p) if p:IsA("BasePart") then p.CollisionGroup="RoyalPlayers" end end)
    record.CharacterConnection=record.Humanoid.Died:Connect(function()
        if record.Status=="Active" then
            if self.Current and self.Current.Mode=="Race" then record.Falls+=1;record.Status="Recovering";record.RecoverAt=workspace:GetServerTimeNow()+Config.RespawnDelay
            else self:queueDeath(record,"Reset / character death") end
        end
    end)
    if record.Status=="Preparing" and self.Map.Model and table.find(self.Roster,record.Player.UserId) then self:teleport(record,self.Map:spawn(table.find(self.Roster,record.Player.UserId)),true)
    elseif record.Status=="Recovering" and self.Map.Model then self:teleport(record,self.Map:checkpoint(record.Checkpoint),false);record.Status="Active"
    else self:toLobby(record) end
    local entry=self.Data:get(record.Player);if entry then Cosmetics.apply(character,entry.Profile,record.Streak) end
end
function Game:add(player)
    if self.Records[player.UserId] then return end
    local record={Player=player,Status="Lobby",Queued=true,Streak=0,Matches=0,Checkpoint=0,Falls=0,ActiveSeconds=0,LastMoved=0,Cooldown=0,DoubleUsed=false,Connections={}}
    self.Records[player.UserId]=record
    table.insert(record.Connections,player.CharacterAdded:Connect(function(character) self:character(record,character) end))
    if player.Character then task.spawn(function() self:character(record,player.Character) end) end
    task.spawn(function() self.Data:load(player) end)
    Analytics.log(player,"new_player_join")
    if self.Map.Model then pcall(function() player:AddReplicationFocus(self.Map.Model.PrimaryPart) end) end
end
function Game:remove(player)
    local record=self.Records[player.UserId]
    if record then
        if record.Status=="Active" or record.Status=="Recovering" or record.Status=="Qualified" then self.PendingDeaths[player.UserId]="Disconnected";Analytics.log(player,"left_during_round") end
        self.Chaos:clearCharacter(record)
        for _,c in record.Connections do c:Disconnect() end
        if record.CharacterConnection then record.CharacterConnection:Disconnect() end
        if record.DescendantConnection then record.DescendantConnection:Disconnect() end
        self.Records[player.UserId]=nil
    end
    self.Limiter:clear(player.UserId);self.Data:remove(player)
end
function Game:teleport(record,cframe,frozen)
    if not record.Root or not record.Root.Parent or not record.Humanoid then return end
    self.Chaos:clearCharacter(record)
    for _,name in {"RoyalDash","RoyalDashAttachment","RoyalImpulse","RoyalImpulseAttachment"} do
        local constraint=record.Root:FindFirstChild(name);if constraint then constraint:Destroy() end
    end
    record.Root.Anchored=frozen==true
    -- Put the root at the spawn even when an avatar uses a different model pivot.
    local rootToPivot=record.Root.CFrame:ToObjectSpace(record.Character:GetPivot())
    record.Character:PivotTo(cframe*rootToPivot)
    record.Root.AssemblyLinearVelocity=Vector3.zero;record.Root.AssemblyAngularVelocity=Vector3.zero
    record.Humanoid.WalkSpeed=if frozen then 0 else Config.WalkSpeed;record.Humanoid.JumpHeight=if frozen then 0 else Config.JumpHeight
    record.Humanoid.AutoRotate=true;record.Humanoid.PlatformStand=false;record.Humanoid.Sit=false
    if not frozen then
        pcall(function() record.Root:SetNetworkOwner(record.Player) end)
        record.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    record.LastPosition=record.Root.Position;record.LastCFrame=record.Root.CFrame;record.MovementGrace=workspace:GetServerTimeNow()+1.5;record.TravelBudget=12
end
function Game:toLobby(record)
    self:teleport(record,self.Lobby:spawn(record.Player.UserId%16+1),false)
    if record.Status~="Qualified" and record.Status~="Eliminated" and record.Status~="Recovering" then record.Status="Lobby" end
end
function Game:ready()
    local result={}
    for _,record in self.Records do
        local entry=self.Data:get(record.Player)
        if record.Queued and record.Root and record.Root.Parent and record.Humanoid and record.Humanoid.Health>0 and entry and entry.Status~="Loading" then table.insert(result,record) end
    end
    table.sort(result,function(a,b) return a.Player.UserId<b.Player.UserId end)
    while #result>Config.MaxPlayers do table.remove(result) end
    return result
end
function Game:activeCount()
    local count=0;for _,r in self.Records do if r.Status=="Active" then count+=1 end end;return count
end
function Game:queueDeath(record,reason)
    if record.Status=="Active" then self.PendingDeaths[record.Player.UserId]=reason end
end
function Game:grant(record,id,xp,crowns,statistics)
    self.Data:submit(record.Player,function(p,day) return Profile.grant(p,id,xp,crowns,statistics,day) end,false)
end
function Game:stat(record,key,id) self:grant(record,id,0,0,{[key]=1}) end
function Game:beginMatch(records)
    self.MatchNumber+=1;self.MatchId=HttpService:GenerateGUID(false);self.RoundIndex=0;self.Result=nil;self.RetryUsed=false
    self.Solo=#records==1 and RunService:IsStudio() and Config.StudioSolo
    self.Competitive=#records>=4 and game.PrivateServerId=="" and not RunService:IsStudio()
    self.StartCount=#records;self.Plan=Rules.plan(#records,self.Solo);self.Roster={}
    self.Lobby:clearKing()
    for _,r in records do
        r.Status="Preparing";r.LockedPower=self.Data:get(r.Player).Profile.SelectedPower;r.ActiveSeconds=0;r.Matches+=1;r.MatchId=self.MatchId;r.ParticipationGranted=false
        table.insert(self.Roster,r.Player.UserId)
        Analytics.log(r.Player,if r.Matches==1 then "first_round_start" else "second_match_started")
    end
    self:nextRound()
end
function Game:nextRound(retry)
    if not retry then self.RoundIndex+=1 end
    local stage=self.Plan[self.RoundIndex]
    if not stage then self:results(nil,"Tournament complete");return end
    local roster={}
    for _,id in self.Roster do local r=self.Records[id];if r and r.Queued then table.insert(roster,id) end end
    self.Roster=roster
    if #roster==0 then self:results(nil,"No participants");return end
    if #roster==1 and not self.Solo then self:results(roster[1],"Last remaining player");return end
    if not retry and #roster<=2 and not self.Solo and stage.Mode~="Final" and self.RoundIndex>1 then self.RoundIndex=#self.Plan;stage=self.Plan[self.RoundIndex] end
    self.RoundId=self.MatchId..":"..self.RoundIndex..(if retry then ":retry" else "")
    self.PendingDeaths={};self.Chaos:stop()
    local id=if stage.Mode=="Race" then (if self.MatchNumber%2==1 then "SkyKingdom" else "NeonCity") elseif stage.Mode=="Survival" then "LavaSurvival" elseif stage.Mode=="RisingDanger" then "LavaAscent" else "CrownClimb"
    if self.Map.Model then for _,r in self.Records do pcall(function() r.Player:RemoveReplicationFocus(self.Map.Model.PrimaryPart) end) end end
    local ok,err=pcall(function() self.Map:load(id) end)
    if not ok then warn(err);self:results(nil,"Map could not load");return end
    self.Current={Mode=stage.Mode,Quota=if self.Solo then 1 elseif stage.Mode=="Final" then 1 else Rules.quota(stage.Quota,#roster),Duration=if retry then 60 else stage.Duration,Retry=retry==true}
    self.Round=nil;self.Started=0
    for _,r in self.Records do pcall(function() r.Player:AddReplicationFocus(self.Map.Model.PrimaryPart) end) end
    for slot,playerId in roster do
        local r=self.Records[playerId];r.Status="Preparing";r.Checkpoint=0;r.Falls=0;r.Moved=0;r.RoundActiveSeconds=0;r.RecoverAt=nil;r.StreamReady=false;Power.reset(r)
        self:teleport(r,self.Map:spawn(slot),true)
        self:effect("Prepare",{Position=self.Map:spawn(slot).Position,RoundId=self.RoundId},r.Player)
    end
    self:state("Preparing",6)
end
function Game:activate()
    local ids={}
    local now=workspace:GetServerTimeNow()
    for _,id in self.Roster do
        local r=self.Records[id]
        if r and r.Queued and r.Status=="Preparing" and r.StreamReady and r.Root and r.Root.Parent and r.Humanoid and r.Humanoid.Health>0 then table.insert(ids,id)
        elseif r then r.Status="Lobby";self:toLobby(r);self:toast(r.Player,"Map not ready. You are queued for the next match.") end
    end
    if #ids==0 or (#ids<2 and not self.Solo) then self:results(nil,"Not enough ready players");return end
    if not self.Solo and self.Current.Mode~="Final" then self.Current.Quota=Rules.quota(self.Current.Quota,#ids) end
    for _,id in ids do
        local r=self.Records[id]
        r.Status="Active";r.Root.Anchored=false;r.Humanoid.WalkSpeed=Config.WalkSpeed;r.Humanoid.JumpHeight=Config.JumpHeight;r.Humanoid.PlatformStand=false;r.Humanoid.Sit=false;r.LastPosition=r.Root.Position;r.LastCFrame=r.Root.CFrame;r.StartedAt=now;r.TravelBudget=12
        pcall(function() r.Root:SetNetworkOwner(r.Player) end)
        self:stat(r,"RoundsPlayed",self.RoundId..":played:"..id)
        if self.Current.Mode=="Final" then self:grant(r,self.MatchId..":final:"..id,75,20,{FinalsReached=1});Analytics.log(r.Player,"final_reached") end
    end
    self.Roster=ids;self.Started=now;self.Map.Model:SetAttribute("RoundStartedAt",now)
    self:state(if self.Current.Mode=="Final" then "Final" else "RoundActive",self.Current.Duration)
    self.Round=RoundModel.new(self.Current.Mode,ids,self.Current.Quota,self.Deadline,self.Solo)
    local seed=Random.new():NextInteger(1,2147483646);self.Seed=seed
    if not self.Current.Retry then self.Chaos:startRound(self.Current.Mode,self.RoundIndex,seed,now) end
end
function Game:movement(record,dt,now)
    local root=record.Root;local previous=record.LastPosition or root.Position;local delta=root.Position-previous
    if not Util.finite(root.Position.X) or not Util.finite(root.Position.Y) or not Util.finite(root.Position.Z) then
        root.CFrame=record.LastCFrame or self.Map:checkpoint(record.Checkpoint);root.AssemblyLinearVelocity=Vector3.zero
        return previous,root.Position,false
    end
    local horizontal=Vector2.new(delta.X,delta.Z).Magnitude
    local ping=0;pcall(function() ping=math.clamp(record.Player:GetNetworkPing(),0,0.5) end)
    local speed=record.Humanoid.WalkSpeed+8
    if now<(record.MovementGrace or 0) then speed=80 end
    local burst=16+ping*32
    record.TravelBudget=math.min(burst+math.max(0,dt-0.25)*speed,(record.TravelBudget or burst)+speed*dt)
    local invalid=horizontal>record.TravelBudget+0.1 or delta.Y>math.max(12,75*dt+ping*30)
    if invalid then
        root.CFrame=record.LastCFrame or root.CFrame;root.AssemblyLinearVelocity=Vector3.zero;record.TravelBudget=burst;record.MovementGrace=now+0.25
        record.Corrections=(record.Corrections or 0)+1
        if record.Corrections%5==1 then Analytics.log(record.Player,"movement_corrected") end
        return previous,previous,false
    end
    record.TravelBudget=math.max(0,record.TravelBudget-horizontal)
    if horizontal>0.15 and now>(record.MovementGrace or 0) then record.Moved=(record.Moved or 0)+horizontal;record.ActiveSeconds+=dt;record.RoundActiveSeconds+=dt end
    record.LastPosition=root.Position;record.LastCFrame=root.CFrame
    return previous,root.Position,true
end
function Game:tickRound(now,dt)
    if not self.Round or self.Round.Done then return end
    self.Map:update(now-self.Started,dt,self.Records,now,self.Round.Overtime)
    if not self.Current.Retry then self.Chaos:update(now) end
    local finishes={}
    for _,id in self.Roster do
        local r=self.Records[id]
        if r and r.Status=="Recovering" and now>=(r.RecoverAt or 0) then
            if r.Humanoid and r.Humanoid.Health>0 then self:teleport(r,self.Map:checkpoint(r.Checkpoint),false);r.Status="Active"
            elseif not r.LoadingCharacter then r.LoadingCharacter=true;task.spawn(function() pcall(function() r.Player:LoadCharacterAsync() end);r.LoadingCharacter=false end) end
        elseif r and r.Status=="Active" and r.Root and r.Root.Parent then
            local before,position,valid=self:movement(r,dt,now)
            if r.Humanoid.FloorMaterial~=Enum.Material.Air then r.DoubleUsed=false end
            local hazard,knock=self.Map:hazard(r,now,before)
            if hazard then
                if self.Current.Mode=="Race" then
                    r.Falls+=1;r.Status="Recovering";r.RecoverAt=now+Config.RespawnDelay
                    self:teleport(r,self.Map:checkpoint(r.Checkpoint),true);self:effect("Recovered",{Reason=hazard},r.Player)
                else self:queueDeath(r,hazard) end
            elseif knock then Power.knock(r,knock,now) end
            if valid and r.Status=="Active" and not self.PendingDeaths[id] and self.Map:progress(r,before,position) and (self.Current.Mode=="Race" or self.Current.Mode=="Final") then table.insert(finishes,id) end
            if not self.Solo and now-r.StartedAt>Config.AFKSeconds and (r.Moved or 0)<3 then r.Queued=false;self:queueDeath(r,"AFK: queue paused") end
            if r.ActiveSeconds>=20 and not r.ParticipationGranted then r.ParticipationGranted=true;self:grant(r,self.MatchId..":participation:"..id,40,5,nil) end
        end
    end
    local deaths={}
    for id in self.PendingDeaths do table.insert(deaths,id) end
    table.sort(deaths)
    self.Round:batch(deaths,finishes,now)
    for _,id in deaths do
        local r=self.Records[id]
        if r and r.Status~="Eliminated" then
            r.Status="Eliminated";r.Streak=0;self:toLobby(r);self:effect("Eliminated",{Reason=self.PendingDeaths[id]},r.Player);Analytics.log(r.Player,"eliminated")
        end
    end
    self.PendingDeaths={}
    local expired=self.Round:expire(now,Config.Overtime)
    if expired=="Overtime" then self.Deadline=self.Round.Deadline;self:effect("Overtime",{Ends=self.Deadline}) end
    for _,id in self.Round.Order do
        local r=self.Records[id]
        if r and r.Status=="Active" and self.Current.Mode~="Final" then
            r.Status="Qualified";self:toLobby(r)
            local perfect=self.Current.Mode=="Race" and r.Falls==0;local clutch=self.Current.Mode=="Race" and now<=self.Round.Deadline and self.Round.Deadline-now<=1
            local increments={Qualifications=1};if perfect then increments.Perfects=1 end;if clutch then increments.Clutches=1 end
            self:grant(r,self.RoundId..":qualified:"..id,50+(if perfect then 10 else 0),15,increments)
            self:effect("Qualified",{Placement=if self.Current.Mode=="Race" then self.Round.Placements[id] else nil,Tie=self.Round.Ties[id],Perfect=perfect,Clutch=clutch,XP=50+(if perfect then 10 else 0)},r.Player);Analytics.log(r.Player,"qualified")
            if not r.FirstFinished then r.FirstFinished=true;Analytics.log(r.Player,"first_round_finish") end
        end
    end
    if self.Round.Done then self:endRound() end
end
function Game:endRound()
    self.Chaos:stop()
    if self.Current.Mode=="Final" then self:results(self.Round.Winner,self.Round.Reason);return end
    local survivors={}
    for _,id in self.Round.Order do local r=self.Records[id];if r and r.Queued then table.insert(survivors,id) end end
    if #survivors==0 and self.Current.Mode=="Race" and not self.RetryUsed and #self.Roster>=2 then
        self.RetryUsed=true;self:toastAll("No finishers. Easier retry: Chaos disabled.");self:nextRound(true);return
    end
    if #survivors<=1 and not self.Solo then self:results(survivors[1],if #survivors==0 then "No qualifiers" else "Last qualifier");return end
    if #survivors==0 then self:results(nil,"No qualifiers");return end
    for _,id in self.Roster do local r=self.Records[id];if r and not table.find(survivors,id) and r.Status~="Eliminated" then r.Status="Eliminated";r.Streak=0;self:toLobby(r);self:effect("Eliminated",{Reason="Qualification time ended"},r.Player) end end
    self.Roster=survivors;self:state("Transition",Config.Transition)
end
function Game:toastAll(message) self:effect("Toast",{Text=message}) end
function Game:results(winnerId,reason)
    self.Chaos:stop()
    local winner=winnerId and self.Records[winnerId]
    local competitive=self.Competitive
    local activeCompetitors=0;for _,r in self.Records do if r.MatchId==self.MatchId and r.ActiveSeconds>=20 then activeCompetitors+=1 end end
    competitive=competitive and activeCompetitors>=2
    for _,r in self.Records do
        if r.Matches>0 and r.Player.UserId~=winnerId and table.find(self.Roster,r.Player.UserId) then r.Streak=0 end
        r.Status="Lobby";self:toLobby(r)
    end
    if winner then
        winner.Streak+=1
        self.Data:submit(winner.Player,function(p,day) return Profile.win(p,self.MatchId..":win",competitive,winner.Streak,day) end,false)
        local displayed,displayError=pcall(function() self.Lobby:showKing(winner.Player) end)
        if not displayed then warn("[Royal Rush] Victory display: "..tostring(displayError)) end
        Analytics.log(winner.Player,"match_win")
    end
    self.Result={WinnerId=winnerId,Winner=if winner then winner.Player.DisplayName else nil,Reason=reason,Streak=if winner then winner.Streak else 0,Competitive=competitive}
    if winner then
        local entry=self.Data:get(winner.Player)
        self.Result.RewardXP=if entry and entry.Mutable then (if competitive then 250 else 100) else 0
        self.Result.RewardCrowns=if entry and entry.Mutable then (if competitive then 60 else 20) else 0
    end
    if winner then
        local entry=self.Data:get(winner.Player)
        local id=entry and entry.Profile.EquippedCosmetics.Victory
        local cosmetic=id and Config.Cosmetics[id]
        if cosmetic and entry.Profile.OwnedCosmetics[id] then self.Result.VictoryColor=cosmetic.Color end
    end
    self:effect("Results",self.Result)
    if self.Map.Model then for _,r in self.Records do pcall(function() r.Player:RemoveReplicationFocus(self.Map.Model.PrimaryPart) end) end end
    self.Map:unload();self:state("Results",Config.Results)
    self.Data:autosave()
end
function Game:send(player)
    local r=self.Records[player.UserId];if not r or not player.Parent then return end
    local living={}
    for _,record in self.Records do if record.Status=="Active" then table.insert(living,{Id=record.Player.UserId,Name=record.Player.DisplayName}) end end
    table.sort(living,function(a,b) return a.Id<b.Id end)
    self.Remotes.State:FireClient(player,{Version=Config.Version,State=self.State,StateVersion=self.StateVersion,Deadline=self.Deadline,ServerNow=workspace:GetServerTimeNow(),MatchId=self.MatchId,RoundId=self.RoundId,RoundIndex=self.RoundIndex,
        Mode=self.Current and self.Current.Mode or "Lobby",Map=self.Map.Info and self.Map.Info.Name or "ROYAL RUSH",Quota=self.Current and self.Current.Quota or 0,Qualified=self.Round and #self.Round.Order or 0,Alive=#living,Living=living,
        Status=r.Status,Queued=r.Queued,Power=r.LockedPower or "Dash",Cooldown=r.Cooldown or 0,Chaos=self.Chaos:view(),Data=self.Data:view(player),Result=self.Result,Board=self.Lobby.Board,Solo=self.Solo==true,Competitive=self.Competitive==true})
end
function Game:broadcast() for _,r in self.Records do self:send(r.Player) end end
function Game:action(player,payload)
    if not RequestValidation.valid(payload) then return end
    local now=workspace:GetServerTimeNow();local action=payload.Action
    if not self.Limiter:allow(player.UserId,action,now) then return end
    local r=self.Records[player.UserId];if not r then return end
    local function done(ok,message) if player.Parent then self:toast(player,message);self:send(player) end end
    if action=="Sync" then self:send(player)
    elseif action=="Ready" then if payload.RoundId==self.RoundId and r.Status=="Preparing" then r.StreamReady=true end
    elseif action=="Power" then
        if activeStates[self.State] and r.Status=="Active" then local ok,message=Power.activate(r,now,function(name,data) self:effect(name,data) end);if ok then self:stat(r,"PowerUses",self.RoundId..":power:"..now..":"..player.UserId) else self:toast(player,message) end;self:send(player)
        elseif r.Status=="Lobby" or r.Status=="Eliminated" or r.Status=="Qualified" then
            local status=r.Status;local entry=self.Data:get(player)
            r.LockedPower=entry and entry.Profile.SelectedPower or "Dash";r.Status="Active"
            local ok,message=Power.activate(r,now,function(name,data) self:effect(name,data) end);r.Status=status
            if not ok then self:toast(player,message) end;self:send(player)
        end
    elseif action=="Queue" then
        if r.Status=="Active" or r.Status=="Preparing" then self:toast(player,"Leave the round first")
        elseif type(payload.Enabled)=="boolean" then r.Queued=payload.Enabled;self:send(player) end
    elseif action=="Lobby" then
        if r.Status=="Active" then r.Queued=false;self:queueDeath(r,"Returned to lobby")
        elseif r.Status=="Preparing" then r.Queued=false;r.Status="Eliminated";self:toLobby(r);self:send(player)
        else self:toLobby(r);self:send(player) end
    elseif action=="Loadout" then
        if type(payload.Id)~="string" or not Config.Powers[payload.Id] then return end
        if table.find(self.Roster,player.UserId) and self.State~="Waiting" and self.State~="Intermission" and self.State~="Results" then self:toast(player,"Loadout locked until this match ends");return end
        self.Data:submit(player,function(p) p.SelectedPower=payload.Id;return true,"Selected "..Config.Powers[payload.Id].Name end,false,done)
    elseif action=="Buy" or action=="Equip" then
        if type(payload.Id)~="string" or #payload.Id>64 then return end
        if r.Status=="Active" or r.Status=="Preparing" then self:toast(player,"Use the shop in the lobby");return end
        self.Data:submit(player,function(p) if action=="Buy" then return Profile.buy(p,payload.Id) else return Profile.equip(p,payload.Id) end end,true,function(ok,message) if ok and action=="Buy" then Analytics.log(player,"purchase") end;done(ok,message) end)
    elseif action=="Daily" then self.Data:submit(player,function(p,day) return Profile.claimDaily(p,day) end,true,function(ok,message) if ok then Analytics.log(player,"daily_claimed") end;done(ok,message) end)
    elseif action=="Quest" then if type(payload.Id)=="string" and #payload.Id<64 then self.Data:submit(player,function(p,day) return Profile.claimQuest(p,payload.Id,day) end,true,done) end
    elseif action=="Settings" then
        if type(payload.Settings)~="table" then return end
        self.Data:submit(player,function(p) return Profile.settings(p,payload.Settings) end,false,done)
    elseif action=="Tutorial" then self.Data:submit(player,function(p) p.TutorialVersion=1;return true,"Ready for the Crown" end,false);Analytics.log(player,"tutorial_complete") end
end
function Game:tick(dt)
    if self.Stopped then return end
    local now=workspace:GetServerTimeNow();local ready=self:ready()
    local minimum=if RunService:IsStudio() and Config.StudioSolo then 1 else Config.MinPlayers
    if self.State=="Waiting" and #ready>=minimum then self.Current=nil;self.Round=nil;self.Solo=#ready==1 and minimum==1;self:state("Intermission",Config.Intermission)
    elseif self.State=="Intermission" then
        if #ready<minimum then self:state("Waiting",0)
        elseif now>=self.Deadline then self:beginMatch(ready) end
    elseif self.State=="Preparing" then
        local allReady=true
        for _,id in self.Roster do local r=self.Records[id];if not r or not r.StreamReady then allReady=false end end
        if allReady or now>=self.Deadline then self:state("RoundIntro",Config.Intro) end
    elseif self.State=="RoundIntro" and now>=self.Deadline then self:activate()
    elseif activeStates[self.State] then self:tickRound(now,dt)
    elseif self.State=="Transition" and now>=self.Deadline then self:nextRound()
    elseif self.State=="Results" and now>=self.Deadline then self.Roster={};self.Round=nil;self.Current=nil;self:state("Waiting",0) end
    if now>=self.NextSnapshot then self.NextSnapshot=now+0.5;self:broadcast() end
    if now-self.LastSave>=Config.Persistence.Autosave then self.LastSave=now;self.Data:autosave() end
    if now-self.LastBoard>=60 then self.LastBoard=now;self.Lobby:refresh(self.Records,self.Data) end
end
function Game:start()
    table.insert(self.Connections,self.Remotes.Action.OnServerEvent:Connect(function(player,payload) local ok,err=pcall(function() self:action(player,payload) end);if not ok then warn("[Royal Rush] Action failed: "..tostring(err)) end end))
    table.insert(self.Connections,Players.PlayerAdded:Connect(function(player) self:add(player) end))
    table.insert(self.Connections,Players.PlayerRemoving:Connect(function(player) self:remove(player) end))
    for _,player in Players:GetPlayers() do self:add(player) end
    local accumulated=0
    table.insert(self.Connections,RunService.Heartbeat:Connect(function(dt)
        accumulated+=dt
        if accumulated>=Config.Tick then local elapsed=accumulated;accumulated=0;local ok,err=pcall(function() self:tick(elapsed) end);if not ok then warn("[Royal Rush] Server tick: "..tostring(err)) end end
    end))
    game:BindToClose(function() self.Stopped=true;self.Chaos:stop();self.Data:close() end)
    print("[Royal Rush] "..Config.Version.." • standard movement + server result validation")
end
return Game
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">LobbyService</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local DataStoreService=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local Lobby={};Lobby.__index=Lobby
function Lobby.new()
    local store
    if not RunService:IsStudio() then pcall(function() store=DataStoreService:GetOrderedDataStore("RoyalRush_Wins_v1") end) end
    return setmetatable({Model=workspace:WaitForChild("RoyalRushLobby"),Board={},Store=store,Names={},Published={},King=nil},Lobby)
end
function Lobby:spawn(slot) local p=Vector3.new(((slot or 1)%4-1.5)*5,39,-31+math.floor((slot or 1)/4)*3);return CFrame.lookAt(p,p+Vector3.zAxis) end
function Lobby:clearKing()
    if self.King then self.King:Destroy();self.King=nil end
end
function Lobby:showKing(player)
    self:clearKing()
    local character=player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local archivable=character.Archivable;character.Archivable=true;local clone=character:Clone();character.Archivable=archivable
    clone.Name="ServerKing";clone.Parent=self.Model;clone:PivotTo(self.Model.Throne.KingSpot.CFrame)
    for _,p in clone:GetDescendants() do
        if p:IsA("Script") or p:IsA("LocalScript") or p:IsA("ModuleScript") or p:IsA("Tool") then p:Destroy()
        elseif p:IsA("BasePart") then p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true end
    end
    clone.HumanoidRootPart.Anchored=true
    local head=clone:FindFirstChild("Head")
    if head then
        local function crownPart(class,size,offset)
            local p=Instance.new(class);p.Name="RoyalCrown";p.Size=size;p.CFrame=head.CFrame*CFrame.new(offset);p.Color=Color3.fromRGB(255,207,76);p.Material=Enum.Material.Metal;p.CanCollide=false;p.CanTouch=false;p.Massless=true;p.Parent=clone
            local weld=Instance.new("WeldConstraint");weld.Part0=head;weld.Part1=p;weld.Parent=p
        end
        crownPart("Part",Vector3.new(2,0.3,2),Vector3.new(0,0.7,0))
        for i=-2,2 do crownPart("WedgePart",Vector3.new(0.4,0.9,0.6),Vector3.new(i*0.4,1.2,0)) end
    end
    local humanoid=clone:FindFirstChildOfClass("Humanoid");if humanoid then humanoid.DisplayName="KING • "..player.DisplayName end
    self.King=clone
    -- Original procedural celebration; no external animation asset is required.
    task.spawn(function()
        local shoulder
        for _,joint in clone:GetDescendants() do if joint:IsA("Motor6D") and (joint.Name=="RightShoulder" or joint.Name=="Right Shoulder") then shoulder=joint;break end end
        if shoulder then
            local start=shoulder.C0
            for i=1,6 do
                if not clone.Parent or not shoulder.Parent then break end
                local tween=TweenService:Create(shoulder,TweenInfo.new(0.3),{C0=start*CFrame.Angles(0,0,math.rad(if i%2==1 then -135 else -100))})
                tween:Play();task.wait(0.35)
            end
            if shoulder.Parent then shoulder.C0=start end
        end
    end)
end
function Lobby:publish(player,entry)
    if not self.Store or not entry.Mutable or entry.Status~="Saved" or entry.Profile.Wins==(self.Published[player.UserId] or -1) then return end
    local wins=entry.Profile.Wins;self.Published[player.UserId]=wins
    task.spawn(function()
        local ok=pcall(function() self.Store:UpdateAsync(tostring(player.UserId),function(old) return math.max(old or 0,wins) end) end)
        if not ok then self.Published[player.UserId]=nil end
    end)
end
function Lobby:refresh(records,data)
    if not self.Store then
        local board={}
        for _,record in records do local entry=data:get(record.Player);if entry then table.insert(board,{Name=record.Player.DisplayName,Wins=entry.Profile.LocalWins,Local=true}) end end
        table.sort(board,function(a,b) return a.Wins>b.Wins end);self.Board=board;return
    end
    task.spawn(function()
        local ok,page=pcall(function() return self.Store:GetSortedAsync(false,10) end)
        if not ok then return end
        local board={}
        for _,entry in page:GetCurrentPage() do
            local id=tonumber(entry.key)
            if id then
                local name=self.Names[id]
                if not name then local success,value=pcall(function() return Players:GetNameFromUserIdAsync(id) end);name=if success then value else "Player";self.Names[id]=name end
                table.insert(board,{Name=name,Wins=entry.value})
            end
        end
        self.Board=board
    end)
end
return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">MapService</string>
          <string name="Source"><![CDATA[local RS=game:GetService("ReplicatedStorage")
local ServerStorage=game:GetService("ServerStorage")
local Catalog=require(RS.RoyalRush.MapCatalog)
local Util=require(RS.RoyalRush.Util)
local Motion=require(RS.RoyalRush.ObstacleMotion)
local Power=require(script.Parent.PowerService)
local Map={};Map.__index=Map
local ORIGIN=CFrame.new(0,120,700)
function Map.new() return setmetatable({Model=nil,Obstacles={},Optional={},Falls={},Event=nil},Map) end
function Map:load(id)
    self:unload()
    local template=ServerStorage:WaitForChild("RoyalRushMaps"):FindFirstChild(id)
    assert(template and Catalog[id],"Map template missing: "..id)
    self.Model=template:Clone();self.Model.Name="RoyalRushArena";self.Model.Parent=workspace;self.Model:PivotTo(ORIGIN)
    self.Id=id;self.Info=Catalog[id];self.RequiredGates=self.Model:GetAttribute("RequiredGates") or 0
    self.Gates=self.Model.Checkpoints:GetChildren();table.sort(self.Gates,function(a,b) return a:GetAttribute("Index")<b:GetAttribute("Index") end)
    self.Spawns=self.Model.Spawns:GetChildren();table.sort(self.Spawns,function(a,b) return a:GetAttribute("Slot")<b:GetAttribute("Slot") end)
    for _,o in self.Model.Obstacles:GetChildren() do
        local body=o:FindFirstChild("Body")
        if body then
            body:SetAttribute("MotionBase",body.CFrame)
            if body:GetAttribute("Carry") or body:GetAttribute("Conveyor") then body.CustomPhysicalProperties=PhysicalProperties.new(1,0.9,0,100,0) end
            table.insert(self.Obstacles,{Model=o,Body=body,Base=body.CFrame,Kind=o:GetAttribute("ObstacleType"),Period=o:GetAttribute("Period") or 7,Phase=o:GetAttribute("Phase") or 0,Distance=o:GetAttribute("Distance") or 4})
        end
    end
    for _,p in self.Model:GetDescendants() do
        if p:IsA("BasePart") and p:GetAttribute("EventOptional") then
            table.insert(self.Optional,{Part=p,Color=p.Color,Material=p.Material,Transparency=p.Transparency,Collide=p.CanCollide})
        end
    end
    self.Finish=self.Model:FindFirstChild("Finish");self.Lava=self.Model:FindFirstChild("Lava")
    self.LavaHeight=-14
    return self.Info
end
function Map:spawn(slot) local position=self.Spawns[(slot-1)%#self.Spawns+1].Position;return CFrame.lookAt(position,position+Vector3.zAxis) end
function Map:checkpoint(index)
    for _,p in self.Model.CheckpointSpawns:GetChildren() do if p:GetAttribute("Index")==index then return CFrame.lookAt(p.Position,p.Position+Vector3.zAxis) end end
    return self:spawn(1)
end
function Map:localPosition(position) return ORIGIN:PointToObjectSpace(position) end
function Map:box(part,a,b,padding)
    if not part then return false end
    return Util.sweptBox(part.CFrame:PointToObjectSpace(a),part.CFrame:PointToObjectSpace(b),part.Size/2+(padding or Vector3.new(1,2,1)))
end
function Map:progress(record,previous,position)
    for _,gate in self.Gates do
        local index=gate:GetAttribute("Index")
        if index==record.Checkpoint+1 and self:box(gate,previous,position,Vector3.new(1,1,1)) then record.Checkpoint=index end
    end
    return record.Checkpoint>=self.RequiredGates and self:box(self.Finish,previous,position)
end
function Map:setEvent(id,now)
    self.Event=if id then {Id=id,Started=now} else nil
    self.Falls={}
    for _,entry in self.Optional do
        local p=entry.Part;p.Color=entry.Color;p.Material=entry.Material;p.Transparency=entry.Transparency;p.CanCollide=entry.Collide
    end
end
function Map:_fall(part,now,delay)
    if not self.Falls[part] then self.Falls[part]={Drop=now+delay,Restore=now+delay+5,Color=part.Color,Transparency=part.Transparency} end
end
function Map:update(elapsed,dt,records,now,overtime)
    if not self.Model then return end
    for _,o in self.Obstacles do
        local body=o.Body
        local cframe,velocity,inactive=Motion.sample(o.Kind,o.Base,elapsed,o.Period,o.Phase,o.Distance)
        body.CFrame=cframe
        if o.Kind=="DoorTiming" or o.Kind=="LaserGate" then
            o.Inactive=inactive;body.Transparency=if inactive then 0.88 else 0.15;body:SetAttribute("Inactive",inactive)
        end
        if body:GetAttribute("Carry") then
            body.AssemblyLinearVelocity=velocity
        elseif body:GetAttribute("Conveyor") then
            body.AssemblyLinearVelocity=o.Base:VectorToWorldSpace(Vector3.new(0,0,o.Model:GetAttribute("BeltSpeed") or 6))
        end
        if body:GetAttribute("FallingTile") then
            for _,r in records do if r.Status=="Active" and r.Root and self:box(body,r.Root.Position,r.Root.Position) then self:_fall(body,now,1.5) end end
        end
    end
    local event=self.Event
    for _,entry in self.Optional do
        local p=entry.Part
        if p:GetAttribute("FallingTile") then
            for _,r in records do if r.Status=="Active" and r.Root and self:box(p,r.Root.Position,r.Root.Position) then self:_fall(p,now,1.5) end end
        end
    end
    if event then
        for index,entry in self.Optional do
            local p=entry.Part;local age=now-event.Started
            if event.Id=="VanishingPlatforms" then
                if index%2==0 then
                    p.Color=if age<2 then Color3.fromRGB(255,211,79) else entry.Color
                    p.Transparency=if age<2 then (0.15+0.25*math.abs(math.sin(age*9))) else 0.85;p.CanCollide=age<2
                end
            elseif event.Id=="WorldBreaking" then
                local drop=2.5+(index%5)*2
                p.Color=Color3.fromRGB(186,99,255);p.Transparency=if age<drop then 0.25 else 1;p.CanCollide=age<drop
            elseif event.Id=="FallingTiles" then
                for _,r in records do if r.Status=="Active" and r.Root and self:box(p,r.Root.Position,r.Root.Position) then self:_fall(p,now,1.7) end end
            end
        end
    end
    for part,state in self.Falls do
        if not part.Parent then self.Falls[part]=nil
        elseif now<state.Drop then part.Color=Color3.fromRGB(255,186,62)
        elseif now<state.Restore then part.CanCollide=false;part.Transparency=0.85
        else part.CanCollide=true;part.Color=state.Color;part.Transparency=state.Transparency;self.Falls[part]=nil end
    end
    if self.Lava then
        local speed=if self.Info.Mode=="Survival" then 0.12 elseif self.Info.Mode=="Final" then 0.48 else 0.4
        self.LavaHeight=-14+math.max(0,elapsed-10)*speed+(if overtime then math.max(0,elapsed-75)*0.12 else 0)
        if self.Info.Mode=="RisingDanger" then
            local safeDeck=self.Model.Core:FindFirstChild("CrownDeck")
            if safeDeck then self.LavaHeight=math.min(self.LavaHeight,self:localPosition(safeDeck.Position).Y+safeDeck.Size.Y/2-1.5) end
        end
        self.Lava.Position=ORIGIN.Position+Vector3.new(0,self.LavaHeight-0.6,0)
    end
end
function Map:hazard(record,now,previous)
    local root=record.Root;if not root then return nil end
    local position=root.Position;local localPos=self:localPosition(position)
    if localPos.Y<(self.Model:GetAttribute("MinY") or -18) then return "Void" end
    if math.abs(localPos.X)>(self.Model:GetAttribute("BoundsX") or 140) or localPos.Z>(self.Model:GetAttribute("BoundsZ") or 650) or localPos.Z< -160 then return "Out of arena" end
    if self.Lava and localPos.Y-2.5<=self.LavaHeight then return "Rising Lava" end
    for _,o in self.Obstacles do
        local p=o.Body
        if not o.Inactive and self:box(p,previous or position,position) then
            if p:GetAttribute("Eliminate") then return "Laser Gate" end
            if p:GetAttribute("Knockback") and now>(record.HitUntil or 0) then return nil,p.Position end
            if p:GetAttribute("JumpPad") and now>(record.PadUntil or 0) and record.Humanoid.FloorMaterial~=Enum.Material.Air then
                record.PadUntil=now+2;Power.velocity(record,58,0.1,Vector3.yAxis);record.MovementGrace=now+0.8
            elseif p:GetAttribute("Wind") and now>(record.WindUntil or 0) then
                record.WindUntil=now+0.25
                Power.velocity(record,record.Root.AssemblyLinearVelocity+Vector3.new(-3,0.5,0),0.08);record.MovementGrace=now+0.3
            end
        end
    end
    return nil
end
function Map:meteorTargets()
    local targets={}
    for _,p in self.Model.MeteorTargets:GetChildren() do
        local safe=true
        for _,gate in self.Gates do if (Vector3.new(p.Position.X,0,p.Position.Z)-Vector3.new(gate.Position.X,0,gate.Position.Z)).Magnitude<15 then safe=false end end
        if self.Finish and (p.Position-self.Finish.Position).Magnitude<25 then safe=false end
        if safe then table.insert(targets,p.Position) end
    end
    return targets
end
function Map:unload()
    if self.Model then self.Model:Destroy() end
    self.Model=nil;self.Info=nil;self.Id=nil;self.Finish=nil;self.Lava=nil;self.Obstacles={};self.Optional={};self.Falls={};self.Event=nil
end
return Map
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">PowerService</string>
          <string name="Source"><![CDATA[local Debris=game:GetService("Debris")
local Config=require(game:GetService("ReplicatedStorage").RoyalRush.Config)
local Util=require(game:GetService("ReplicatedStorage").RoyalRush.Util)
local Power={}
function Power.velocity(record,value,duration,axis)
    local root=record.Root
    local old=root:FindFirstChild("RoyalImpulse");if old then old:Destroy() end
    local oldAttachment=root:FindFirstChild("RoyalImpulseAttachment");if oldAttachment then oldAttachment:Destroy() end
    local attachment=Instance.new("Attachment");attachment.Name="RoyalImpulseAttachment";attachment.Parent=root
    local constraint=Instance.new("LinearVelocity");constraint.Name="RoyalImpulse";constraint.Attachment0=attachment;constraint.RelativeTo=Enum.ActuatorRelativeTo.World
    if axis then
        constraint.VelocityConstraintMode=Enum.VelocityConstraintMode.Line;constraint.LineDirection=axis;constraint.LineVelocity=value
    else constraint.VelocityConstraintMode=Enum.VelocityConstraintMode.Vector;constraint.VectorVelocity=value end
    constraint.ForceLimitsEnabled=false;constraint.Parent=root
    Debris:AddItem(constraint,duration);Debris:AddItem(attachment,duration+0.05)
end
function Power.clearShield(record)
    record.ShieldUntil=0
    local old=record.Character and record.Character:FindFirstChild("RoyalShield")
    if old then old:Destroy() end
end
function Power.reset(record)
    Power.clearShield(record)
    record.Cooldown=0;record.DoubleUsed=false;record.ShieldUntil=0;record.HitUntil=0
end
function Power.activate(record,now,effect)
    if record.Status~="Active" or not record.Root or not record.Humanoid or record.Humanoid.Health<=0 then return false,"Power unavailable" end
    local id=record.LockedPower or "Dash";local config=Config.Powers[id]
    if not config or now<(record.Cooldown or 0) then return false,"Cooling down" end
    local root=record.Root
    if id=="DoubleJump" then
        if record.DoubleUsed or record.Humanoid.FloorMaterial~=Enum.Material.Air then return false,"Use while airborne" end
        Power.velocity(record,config.Velocity,0.1,Vector3.yAxis)
        record.DoubleUsed=true;record.MovementGrace=now+0.8
    elseif id=="Dash" then
        local look=root.CFrame.LookVector;local direction=Vector3.new(look.X,0,look.Z)
        if not Util.finite(direction.X) or not Util.finite(direction.Z) then return false,"Invalid direction" end
        if direction.Magnitude<0.01 then return false,"No direction" end
        direction=direction.Unit
        local parameters=RaycastParams.new();parameters.FilterType=Enum.RaycastFilterType.Exclude;parameters.FilterDescendantsInstances={record.Character};parameters.RespectCanCollide=true
        -- Sweep the avatar's width, so a clear centre ray cannot dash its shoulder into a wall.
        local hit=workspace:Blockcast(CFrame.new(root.Position),Vector3.new(3,3,3),direction*config.Distance,parameters)
        local distance=if hit then math.max(0,hit.Distance-0.5) else config.Distance
        if distance<1 then return false,"Path blocked" end
        local attachment=Instance.new("Attachment");attachment.Name="RoyalDashAttachment";attachment.Parent=root
        local velocity=Instance.new("LinearVelocity");velocity.Name="RoyalDash";velocity.Attachment0=attachment;velocity.RelativeTo=Enum.ActuatorRelativeTo.World;velocity.VelocityConstraintMode=Enum.VelocityConstraintMode.Plane
        velocity.PrimaryTangentAxis=Vector3.xAxis;velocity.SecondaryTangentAxis=Vector3.zAxis;velocity.PlaneVelocity=Vector2.new(direction.X,direction.Z)*(distance/config.Duration);velocity.ForceLimitsEnabled=false;velocity.Parent=root
        Debris:AddItem(velocity,config.Duration);Debris:AddItem(attachment,config.Duration+0.05);record.MovementGrace=now+0.5
    elseif id=="Shield" then
        Power.clearShield(record);record.ShieldUntil=now+config.Duration
        local aura=Instance.new("Highlight");aura.Name="RoyalShield";aura.Adornee=record.Character;aura.FillColor=Color3.fromRGB(116,243,231);aura.OutlineColor=aura.FillColor;aura.FillTransparency=0.85;aura.OutlineTransparency=0.15;aura.Parent=record.Character;Debris:AddItem(aura,config.Duration)
    end
    record.Cooldown=now+config.Cooldown
    effect("Power",{UserId=record.Player.UserId,Id=id,Position=root.Position,Direction=root.CFrame.LookVector})
    return true,"Power activated"
end
function Power.knock(record,center,now)
    if now<(record.ShieldUntil or 0) then Power.clearShield(record);record.HitUntil=now+1;return false end
    if not record.Root then return false end
    local direction=record.Root.Position-center;direction=Vector3.new(direction.X,0,direction.Z)
    if direction.Magnitude<0.1 then direction=Vector3.new(1,0,0) end
    Power.velocity(record,direction.Unit*25+Vector3.new(0,15,0),0.12)
    record.HitUntil=now+1;record.MovementGrace=now+0.7
    return true
end
return Power
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
