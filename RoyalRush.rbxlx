          <string name="Source"><![CDATA[return {
    en={Waiting="WAITING FOR PLAYERS",Next="NEXT ROUND",Race="REACH THE FINISH",Survival="STAY ALIVE",RisingDanger="CLIMB ABOVE THE LAVA",Final="REACH THE CROWN. DON'T FALL.",Qualified="QUALIFIED!",Eliminated="ELIMINATED",Watch="SPECTATE",Lobby="LOBBY",Power="POWER",Shop="SHOP",Loadout="LOADOUT",Daily="DAILY",Settings="SETTINGS",Queue="AUTO QUEUE",Paused="QUEUE PAUSED",Close="CLOSE",Select="SELECT",Selected="SELECTED",Buy="BUY",Equip="EQUIP",Equipped="EQUIPPED",Claim="CLAIM",Claimed="CLAIMED",Temporary="STUDIO TEST • PROGRESS IS TEMPORARY",ReadOnly="SAVE UNAVAILABLE • PROGRESS NOT SAVED",Tutorial="Reach the finish. Survive Chaos. Claim the Crown.",Skip="LET'S PLAY",Ready="READY",Chaos="CHAOS INCOMING",NoWinner="DRAW — NEXT CROWN SOON",Wins="WINS",LocalWins="LOCAL WINS",Quest="DAILY QUESTS",NextMatch="MATCH IN PROGRESS • NEXT MATCH QUEUED"},
    tr={Waiting="OYUNCULAR BEKLENİYOR",Next="SONRAKİ TUR",Race="BİTİŞE ULAŞ",Survival="HAYATTA KAL",RisingDanger="LAVDAN YUKARI TIRMAN",Final="TACA ULAŞ. DÜŞME.",Qualified="TURU GEÇTİN!",Eliminated="ELENDİN",Watch="İZLE",Lobby="LOBİ",Power="GÜÇ",Shop="MAĞAZA",Loadout="GÜÇ SEÇ",Daily="GÜNLÜK",Settings="AYARLAR",Queue="OTOMATİK KATIL",Paused="KATILIM DURDU",Close="KAPAT",Select="SEÇ",Selected="SEÇİLİ",Buy="AL",Equip="KUŞAN",Equipped="KUŞANILDI",Claim="AL",Claimed="ALINDI",Temporary="STUDIO TESTİ • İLERLEME GEÇİCİ",ReadOnly="KAYIT KULLANILAMIYOR • İLERLEME SAKLANMIYOR",Tutorial="Bitişe ulaş. Kaostan kurtul. Tacı kazan.",Skip="OYUNA BAŞLA",Ready="HAZIR",Chaos="KAOS GELİYOR",NoWinner="BERABERE — YENİ TAÇ YAKINDA",Wins="GALİBİYET",LocalWins="YEREL GALİBİYET",Quest="GÜNLÜK GÖREVLER",NextMatch="MAÇ SÜRÜYOR • SONRAKİ MAÇA KATILACAKSIN"},
}
