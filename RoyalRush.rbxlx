        <Item class="ModuleScript" referent="813">
          <Properties>
            <string name="Name">Accessibility</string>
            <string name="Source"><![CDATA[-- Symbols supplement colors; these are local, anchored UI, not server physics.
local Accessibility={Icons={}}
function Accessibility.update(arena,enabled)
    for part,icon in Accessibility.Icons do
        if not enabled or not part.Parent or not arena or not part:IsDescendantOf(arena) then
            icon:Destroy();Accessibility.Icons[part]=nil
        end
    end
    if not enabled or not arena then return end
    for _,part in arena:GetDescendants() do
        if part:IsA("BasePart") and not Accessibility.Icons[part] then
            local symbol=if part.Name=="Finish" then "GO" elseif part:GetAttribute("JumpPad") then "↑" elseif part:GetAttribute("Lava") or part:GetAttribute("Eliminate") or part:GetAttribute("Knockback") then "!" elseif part:GetAttribute("EventOptional") then "?" else nil
            if symbol then
                local gui=Instance.new("BillboardGui");gui.Name="RoyalColorAssist";gui.Adornee=part;gui.Size=UDim2.fromOffset(38,30);gui.StudsOffset=Vector3.new(0,part.Size.Y/2+1.5,0);gui.MaxDistance=90;gui.AlwaysOnTop=false;gui.Parent=part
                local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundColor3=Color3.fromRGB(15,19,30);label.BackgroundTransparency=0.2;label.BorderSizePixel=0;label.Text=symbol;label.TextColor3=Color3.new(1,1,1);label.TextSize=22;label.Font=Enum.Font.GothamBold;label.Parent=gui
                Accessibility.Icons[part]=gui
            end
        end
    end
end
return Accessibility
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="814">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[local SoundService=game:GetService("SoundService")
local Debris=game:GetService("Debris")
local Config=require(game:GetService("ReplicatedStorage").RoyalRush.Config)
local Audio={Music=nil,Settings=Config.Settings}
-- Built-in Roblox content fallback. Original WAVs are also shipped for later asset import.
-- Built-in character sound paths documented in Roblox/Core-Scripts.
-- Original music/SFX in content/audio can replace these after owner upload.
local fallback={Click="rbxasset://sounds/action_jump_land.mp3",Power="rbxasset://sounds/action_jump.mp3",Warning="rbxasset://sounds/action_jump.mp3",Qualified="rbxasset://sounds/action_get_up.mp3",Eliminated="rbxasset://sounds/impact_water.mp3",Victory="rbxasset://sounds/action_get_up.mp3",Countdown="rbxasset://sounds/action_jump_land.mp3"}
function Audio.configure(settings) Audio.Settings=settings;if Audio.Music then Audio.Music.Volume=settings.Music end end
function Audio.play(id)
    if not Config.Audio.Enabled or Audio.Settings.SFX<=0 then return end
    local asset=Config.Audio.Custom[id] or fallback[id];if not asset or asset=="" then return end
    local sound=Instance.new("Sound");sound.Name="RoyalRushSFX";sound.SoundId=asset;sound.Volume=Audio.Settings.SFX*0.5
    sound.PlaybackSpeed=if id=="Victory" then 0.8 elseif id=="Warning" then 0.9 else 1.1;sound.Parent=SoundService;sound:Play();Debris:AddItem(sound,5)
end
function Audio.music(kind)
    local asset=Config.Audio.Custom[kind]
    if Audio.Music and Audio.Music:GetAttribute("Kind")==kind then return end
    if Audio.Music then Audio.Music:Destroy();Audio.Music=nil end
    if not asset or asset=="" then return end
    local sound=Instance.new("Sound");sound.Name="RoyalRushMusic";sound.SoundId=asset;sound.Volume=Audio.Settings.Music;sound.Looped=true;sound:SetAttribute("Kind",kind);sound.Parent=SoundService;sound:Play();Audio.Music=sound
end
return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="815">
          <Properties>
            <string name="Name">CharacterMotion</string>
            <string name="Source"><![CDATA[-- Small additive poses layered over Roblox's normal walk/jump Animate script.
-- No replacement animation IDs or server-side joint writes.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Motion={}
local bound={};local bursts={}
local function bind(character)
    task.spawn(function()
        local humanoid=character:WaitForChild("Humanoid",10)
        local root=character:WaitForChild("HumanoidRootPart",10)
        if not humanoid or not root or not character.Parent then return end
        local joints={}
        for _,joint in character:GetDescendants() do
            if joint:IsA("Motor6D") and (joint.Name=="Waist" or joint.Name=="RootJoint" or joint.Name=="RightShoulder" or joint.Name=="LeftShoulder") then
                joints[joint.Name]={Joint=joint,Base=joint.C0}
            end
        end
        bound[character]={Humanoid=humanoid,Root=root,Joints=joints,Lean=0}
    end)
end
function Motion.power(data)
    if data.Id=="Dash" or data.Id=="DoubleJump" then bursts[data.UserId]={Id=data.Id,Ends=workspace:GetServerTimeNow()+0.28} end
end
function Motion.start(reduced)
    local function playerAdded(player)
        if player.Character then bind(player.Character) end
        player.CharacterAdded:Connect(bind)
    end
    for _,player in Players:GetPlayers() do playerAdded(player) end
    Players.PlayerAdded:Connect(playerAdded)
    RunService.PreSimulation:Connect(function(dt)
        local now=workspace:GetServerTimeNow()
        for character,entry in bound do
            if not character.Parent or not entry.Root.Parent then bound[character]=nil;continue end
            local player=Players:GetPlayerFromCharacter(character)
            local burst=player and bursts[player.UserId]
            if burst and now>=burst.Ends then bursts[player.UserId]=nil;burst=nil end
            local disabled=reduced and reduced()
            local target=if disabled or entry.Humanoid.Health<=0 then 0 elseif burst and burst.Id=="Dash" then math.rad(-20) elseif burst then math.rad(8) else -math.rad(3)*entry.Humanoid.MoveDirection.Magnitude
            entry.Lean+=(target-entry.Lean)*(1-math.exp(-dt*22))
            for name,pose in entry.Joints do
                if pose.Joint.Parent then
                    local angle=if name=="Waist" or name=="RootJoint" then entry.Lean else (if burst and not disabled then -entry.Lean*1.3 else 0)
                    pose.Joint.C0=pose.Base*CFrame.Angles(angle,0,0)
                end
            end
        end
    end)
end
return Motion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="816">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local Effects={}
local function visual(shape,position,size,color)
    local p=Instance.new("Part");p.Name="RoyalRushLocalFX";p.Shape=shape;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Size=size;p.Position=position;p.Material=Enum.Material.Neon;p.Color=color;p.Transparency=0.35;p.Parent=workspace
    return p
end
function Effects.meteorWarning(data,low)
    local disc=visual(Enum.PartType.Cylinder,data.Position+Vector3.new(0,0.2,0),Vector3.new(0.15,data.Radius*2,data.Radius*2),Color3.fromRGB(255,74,72));disc.CFrame=CFrame.new(disc.Position)*CFrame.Angles(0,0,math.pi/2)
    Debris:AddItem(disc,2.5)
    if not low then
        local meteor=visual(Enum.PartType.Ball,data.Position+Vector3.new(0,55,0),Vector3.new(3,3,3),Color3.fromRGB(255,165,55))
        TweenService:Create(meteor,TweenInfo.new(2.2,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=data.Position}):Play();Debris:AddItem(meteor,2.25)
    end
end
function Effects.meteorHit(data,low)
    if low then return end
    local ball=visual(Enum.PartType.Ball,data.Position,Vector3.new(1,1,1),Color3.fromRGB(255,128,79))
    TweenService:Create(ball,TweenInfo.new(0.35),{Size=Vector3.new(10,5,10),Transparency=1}):Play();Debris:AddItem(ball,0.4)
end
function Effects.shock(data,warning)
    local ring=visual(Enum.PartType.Cylinder,data.Position,Vector3.new(0.1,2,2),Color3.fromRGB(188,111,255));ring.CFrame=CFrame.new(ring.Position)*CFrame.Angles(0,0,math.pi/2)
    TweenService:Create(ring,TweenInfo.new(if warning then 2 else 0.5),{Size=Vector3.new(0.1,110,110),Transparency=1}):Play();Debris:AddItem(ring,if warning then 2.1 else 0.6)
end
function Effects.power(data,low)
    if low then return end
    local color=if data.Id=="Shield" then Color3.fromRGB(105,244,221) else Color3.fromRGB(76,176,255)
    if data.Id=="Dash" then
        local direction=data.Direction or Vector3.zAxis
        for _,side in {-1,1} do
            local streak=visual(Enum.PartType.Block,data.Position,Vector3.new(0.12,0.12,7),color)
            streak.CFrame=CFrame.lookAt(data.Position,data.Position+direction)*CFrame.new(side*1.5,0,2)
            TweenService:Create(streak,TweenInfo.new(0.22),{Transparency=1,Size=Vector3.new(0.05,0.05,2)}):Play();Debris:AddItem(streak,0.25)
        end
    else
        local sphere=visual(Enum.PartType.Ball,data.Position,Vector3.new(2,2,2),color)
        TweenService:Create(sphere,TweenInfo.new(0.3),{Size=Vector3.new(4,4,4),Transparency=1}):Play();Debris:AddItem(sphere,0.35)
    end
end
function Effects.confetti(root,low,color)
    if low then return end
    for index=1,22 do
        local frame=Instance.new("Frame");frame.Name="Confetti";frame.Size=UDim2.fromOffset(6,10);frame.Position=UDim2.fromScale(math.random(),-0.05);frame.Rotation=math.random(0,360);frame.BackgroundColor3=if color and index%2==0 then Color3.fromRGB(unpack(color)) elseif index%2==0 then Color3.fromRGB(255,214,76) else Color3.fromRGB(183,112,255);frame.BorderSizePixel=0;frame.ZIndex=30;frame.Parent=root
        TweenService:Create(frame,TweenInfo.new(2.5+math.random()),{Position=UDim2.fromScale(math.random(),1.1),Rotation=frame.Rotation+180,BackgroundTransparency=1}):Play();Debris:AddItem(frame,4)
    end
end
return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="817">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local Prompts=game:GetService("ProximityPromptService")
local player=Players.LocalPlayer
local Shared=RS:WaitForChild("RoyalRush")
local Config=require(Shared.Config)
local Strings=require(Shared.Strings)
local Util=require(Shared.Util)
local language=if string.sub(player.LocaleId,1,2)=="tr" then Strings.tr else Strings.en
local UI=require(script.Parent.UI)
local Effects=require(script.Parent.Effects)
local Audio=require(script.Parent.Audio)
local Accessibility=require(script.Parent.Accessibility)
require(script.Parent.SurfaceMotion).start()
local refs=UI.build(player:WaitForChild("PlayerGui"))
local network=RS:WaitForChild("RoyalRushRemotes")
local action=network:WaitForChild("Action")
local state={State="Waiting",StateVersion=-1,Status="Lobby",Queued=true,Living={},Data={Ready=false},Cooldown=0}
local settings=Util.copy(Config.Settings)
local CharacterMotion=require(script.Parent.CharacterMotion)
CharacterMotion.start(function() return settings.LowEffects end)
local tab=nil;local modalRevision=-1;local spectating=false;local targetId=nil;local tutorialShown=false;local toastUntil=0;local lastCountdown=-1
local function send(name,extras)
    local payload=extras or {};payload.Action=name;action:FireServer(payload)
end
local function toast(text,color,duration)
    refs.ToastText.Text=tostring(text or "");refs.ToastText.TextColor3=color or UI.Colors.White;refs.Toast.Visible=true;toastUntil=workspace:GetServerTimeNow()+(duration or 2.3)
end
local function resetCamera()
    local camera=workspace.CurrentCamera
    local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if camera and humanoid then camera.CameraType=Enum.CameraType.Custom;camera.CameraSubject=humanoid end
    refs.Spectator.Visible=false;targetId=nil
end
local function chooseTarget(direction)
    if #state.Living==0 then spectating=false;resetCamera();return end
    local index=1
    for i,entry in state.Living do if entry.Id==targetId then index=i;break end end
    index=(index-1+(direction or 0))%#state.Living+1
    local entry=state.Living[index]
    if entry.Id==player.UserId and #state.Living>1 then index=index%#state.Living+1;entry=state.Living[index] end
    local target=Players:GetPlayerByUserId(entry.Id)
    local humanoid=target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        targetId=entry.Id;workspace.CurrentCamera.CameraType=Enum.CameraType.Custom;workspace.CurrentCamera.CameraSubject=humanoid;refs.Target.Text=entry.Name;refs.Spectator.Visible=true
    else targetId=nil;refs.Target.Text="Loading player...";refs.Spectator.Visible=true end
end
local function canPower()
    local playing=(state.State=="RoundActive" or state.State=="Final") and state.Status=="Active"
    local practice=not spectating and (state.Status=="Lobby" or state.Status=="Eliminated" or state.Status=="Qualified")
    return (playing or practice) and not refs.Modal.Visible
end
local function requestPower()
    if canPower() and not UIS:GetFocusedTextBox() then send("Power") end
end
refs.Power.Activated:Connect(requestPower)
CAS:BindAction("RoyalRushPower",function(_,inputState) if inputState==Enum.UserInputState.Begin and canPower() then requestPower();return Enum.ContextActionResult.Sink end;return Enum.ContextActionResult.Pass end,false,Enum.KeyCode.Q,Enum.KeyCode.ButtonX)
local function closeModal() tab=nil;refs.Modal.Visible=false end
refs.Close.Activated:Connect(closeModal)
local renderModal
local function openModal(name)
    tab=name;modalRevision=-1;refs.Modal.Visible=true;renderModal();Audio.play("Click")
end
renderModal=function()
    if not tab then return end
    local p=state.Data or {};local scroll=refs.Content.CanvasPosition
    UI.clearContent(refs.Content);refs.ModalTitle.Text=language[tab] or string.upper(tab)
    if not p.Ready then UI.row(refs.Content,"Loading","Waiting for server profile",UI.Colors.Muted);return end
    if tab=="Loadout" then
        for _,id in {"Dash","DoubleJump","Shield"} do
            local item=Config.Powers[id]
            local button=UI.row(refs.Content,item.Name,item.Description.." • "..item.Cooldown.."s",Color3.fromRGB(unpack(item.Color)))
            button.Text=if p.SelectedPower==id then language.Selected else language.Select
            button.Activated:Connect(function() send("Loadout",{Id=id}) end)
        end
    elseif tab=="Shop" then
        for _,id in Config.CosmeticOrder do
            local item=Config.Cosmetics[id];local owned=p.OwnedCosmetics and p.OwnedCosmetics[id]
            local equipped=p.EquippedCosmetics and p.EquippedCosmetics[item.Kind]==id
            local button=UI.row(refs.Content,item.Name,item.Kind.." • "..item.Rarity.." • "..item.Price.." Crowns",UI.Colors.Gold)
            button.Text=if equipped then language.Equipped elseif owned then language.Equip else language.Buy
            button.BackgroundColor3=if equipped then Color3.fromRGB(43,103,87) else UI.Colors.Purple
            button.Activated:Connect(function() send(if owned then "Equip" else "Buy",{Id=id}) end)
        end
    elseif tab=="Daily" then
        local claimed=p.Daily.LastDay>=p.Day;local step=p.Daily.Step%7+1
        for index,reward in Config.Daily do
            local detail=if reward.Cosmetic then Config.Cosmetics[reward.Cosmetic].Name elseif reward.XP then "+"..reward.XP.." XP" else "+"..reward.Crowns.." Crowns"
            local button=UI.row(refs.Content,"DAY "..index,detail,if index==step then UI.Colors.Gold else UI.Colors.Muted)
            button.Text=if index==step and not claimed then language.Claim elseif index==p.Daily.Step and claimed then language.Claimed else "—"
            button.Active=index==step and not claimed;button.AutoButtonColor=button.Active
            if button.Active then button.Activated:Connect(function() send("Daily") end) end
        end
        local heading=UI.label(refs.Content,"QuestHeader",language.Quest,UDim2.new(1,-8,0,34),nil,18,UI.Colors.Purple)
        for _,quest in Config.Quests do
            local count=p.Quests.Counts[quest.Id] or 0
            local button=UI.row(refs.Content,quest.Name,count.." / "..quest.Target.." • +"..quest.Crowns.." Crowns",UI.Colors.White)
            button.Text=if p.Quests.Claimed[quest.Id] then language.Claimed else language.Claim
            button.Activated:Connect(function() send("Quest",{Id=quest.Id}) end)
        end
    elseif tab=="Settings" then
        for _,key in {"Music","SFX","ReducedShake","ReducedParticles","ColorAssist","AutoSpectate","LowEffects"} do
            local value=settings[key]
            local button=UI.row(refs.Content,key,if type(value)=="number" then "Tap to cycle volume" else "Tap to toggle",UI.Colors.White)
            button.Text=if type(value)=="number" then tostring(math.floor(value*100)).."%" else (if value then "ON" else "OFF")
            button.Activated:Connect(function()
                local nextValue=if type(value)=="number" then (math.floor(value*4+0.1)+1)%5/4 else not value
                settings[key]=nextValue;Audio.configure(settings);send("Settings",{Settings={[key]=nextValue}});renderModal()
            end)
        end
    elseif tab=="Leaderboard" then
        if #(state.Board or {})==0 then UI.row(refs.Content,"NO RESULTS YET","Earn a Crown to appear",UI.Colors.Gold) end
        for index,entry in state.Board or {} do UI.row(refs.Content,"#"..index.."  "..entry.Name,entry.Wins.." "..(if entry.Local then language.LocalWins else language.Wins),UI.Colors.Gold) end
    end
    refs.Content.CanvasPosition=scroll;modalRevision=tostring(p.Revision or 0)..":"..tostring(p.Day or 0)
end
for name,button in refs.Buttons do button.Text=language[name] or name;button.Activated:Connect(function() openModal(name) end) end
refs.Queue.Activated:Connect(function() send("Queue",{Enabled=not state.Queued}) end)
refs.Watch.Text=language.Watch;refs.Lobby.Text=language.Lobby
refs.Watch.Activated:Connect(function() spectating=not spectating;if spectating then chooseTarget(0) else resetCamera() end end)
refs.Lobby.Activated:Connect(function() spectating=false;resetCamera();send("Lobby") end)
refs.Previous.Activated:Connect(function() chooseTarget(-1) end);refs.Next.Activated:Connect(function() chooseTarget(1) end)
local gear=UI.button(refs.Root,"ActiveSettings","⚙",UDim2.fromOffset(32,30),UDim2.fromOffset(10,141),UI.Colors.Panel)
gear.Visible=false;gear.Activated:Connect(function() openModal("Settings") end)
Prompts.PromptTriggered:Connect(function(prompt,who)
    if who and who~=player then return end
    local name=prompt.ObjectText
    local tabs={LOADOUT="Loadout",SHOP="Shop",DAILY="Daily",LEADERBOARD="Leaderboard"}
    if tabs[name] then openModal(tabs[name]) end
end)
local function applySnapshot(snapshot)
    if snapshot.StateVersion<state.StateVersion then return end
    local previous=state;state=snapshot
    if state.Data and state.Data.Settings then settings=Util.copy(state.Data.Settings);Audio.configure(settings) end
    local active=state.Status=="Active" or state.Status=="Preparing" or state.Status=="Recovering"
    refs.Toolbar.Visible=not active;refs.Queue.Visible=not active;gear.Visible=active
    refs.Queue.Text=if state.Queued then language.Queue else language.Paused
    refs.Watch.Visible=not active and #state.Living>0;refs.Lobby.Visible=not active and (state.Status=="Eliminated" or state.Status=="Qualified" or spectating)
    if active then
        if spectating or previous.Status~=state.Status or previous.RoundId~=state.RoundId then resetCamera() end
        spectating=false;if previous.RoundId~=state.RoundId then closeModal() end
    end
    if state.Status~=previous.Status and (state.Status=="Eliminated" or state.Status=="Qualified") and settings.AutoSpectate and #state.Living>0 then spectating=true;chooseTarget(0) end
    if spectating then
        local found=false;for _,entry in state.Living do if entry.Id==targetId then found=true end end
        if not found then chooseTarget(0) end
    end
    refs.Stats.Text=if state.Data.Ready then "LV "..state.Data.Level.."   •   "..state.Data.Crowns.." CROWNS" else "Loading profile..."
    refs.Saved.Text=if state.Data.Ready and not state.Data.Persistent then (if state.Data.Mutable then language.Temporary else language.ReadOnly) else (state.Data.SaveStatus or "")
    refs.Saved.TextColor3=if not state.Data.Persistent then UI.Colors.Gold else UI.Colors.Muted
    if state.State=="Waiting" then refs.Name.Text=language.Waiting;refs.Objective.Text="ROYAL RUSH • CHAOS + CROWN";refs.Quota.Text=if state.Solo then "SOLO STUDIO PREVIEW" else "2–16 PLAYERS"
    elseif state.State=="Intermission" then refs.Name.Text=language.Next;refs.Objective.Text=if state.Solo then "SOLO STUDIO PREVIEW" else "ROYAL RUSH";refs.Quota.Text=if state.Competitive then "CROWN TOURNAMENT" else "LOCAL MATCH"
    elseif state.State=="Results" then refs.Name.Text=if state.Result and state.Result.Winner then state.Result.Winner.." WINS!" else language.NoWinner;refs.Objective.Text=state.Result and state.Result.Reason or "";refs.Quota.Text="NEXT MATCH SOON"
    else refs.Name.Text=state.Map;refs.Objective.Text=language[state.Mode] or state.Mode;refs.Quota.Text=if state.Mode=="Race" then "QUALIFIED "..state.Qualified.." / "..state.Quota else "ALIVE "..state.Alive end
    if state.Status=="Lobby" and (state.State=="RoundActive" or state.State=="Final" or state.State=="Transition") then
        refs.Objective.Text=language.NextMatch;refs.Quota.Text="ROUND "..state.RoundIndex.." • "..language.Watch
    end
    refs.Chaos.Visible=state.Chaos~=nil
    if state.Chaos then refs.ChaosText.Text=state.Chaos.Name end
    if tab and modalRevision~=(tostring(state.Data.Revision or 0)..":"..tostring(state.Data.Day or 0)) then renderModal() end
    if state.Data.Ready and state.Data.TutorialVersion==0 and not tutorialShown then
        tutorialShown=true;toast(language.Tutorial,UI.Colors.Gold,6);send("Tutorial")
    end
    if previous.State~=state.State then Audio.music(if state.State=="Final" then "FinalMusic" elseif state.State=="RoundActive" then "RoundMusic" else "LobbyMusic") end
end
network:WaitForChild("State").OnClientEvent:Connect(applySnapshot)
network:WaitForChild("Effect").OnClientEvent:Connect(function(name,data)
    local low=settings.LowEffects or settings.ReducedParticles
    if name=="Prepare" then
        spectating=false;resetCamera();closeModal()
        local position=data.Position
        workspace.CurrentCamera.CFrame=CFrame.lookAt(position+Vector3.new(0,8,-16),position+Vector3.new(0,2,4))
        task.spawn(function()
            local ok=pcall(function() player:RequestStreamAroundAsync(data.Position,3) end)
            if ok then send("Ready",{RoundId=data.RoundId}) else toast("Map streaming failed. Waiting for next match.",UI.Colors.Gold,4) end
        end)
    elseif name=="Toast" then toast(data.Text)
    elseif name=="Qualified" then toast(language.Qualified..(if data.Placement then "  #"..data.Placement..(if data.Tie then " TIE" else "") else "")..(if data.Clutch then "  CLUTCH!" elseif data.Perfect then "  PERFECT!" else "")..(if state.Data.Mutable and data.XP then "  +"..data.XP.." XP" else ""),UI.Colors.Green,3);Audio.play("Qualified")
    elseif name=="Eliminated" then toast(language.Eliminated.." • "..tostring(data.Reason),UI.Colors.Red,3);Audio.play("Eliminated")
    elseif name=="Recovered" then toast("CHECKPOINT • "..data.Reason,UI.Colors.Blue,1)
    elseif name=="ChaosWarning" then toast(language.Chaos,UI.Colors.Purple,2.5);Audio.play("Warning")
    elseif name=="ChaosStart" then toast(data.Name,UI.Colors.Purple,2);Audio.play("Warning")
    elseif name=="MeteorWarning" then Effects.meteorWarning(data,low)
    elseif name=="MeteorHit" then Effects.meteorHit(data,low)
    elseif name=="ShockwaveWarning" then Effects.shock(data,true)
    elseif name=="ShockwaveHit" then Effects.shock(data,false)
    elseif name=="Power" then CharacterMotion.power(data);Effects.power(data,low);if data.UserId==player.UserId then Audio.play("Power") end
    elseif name=="Overtime" then toast("OVERTIME!",UI.Colors.Gold,3)
    elseif name=="Results" then
        spectating=false;resetCamera();closeModal()
        local reward=if data.WinnerId==player.UserId then "  +"..(data.RewardXP or 0).." XP / +"..(data.RewardCrowns or 0).." CROWNS" else ""
        toast(if data.Winner then data.Winner.." WINS THE CROWN!"..reward else language.NoWinner,UI.Colors.Gold,5)
        if data.Winner then Effects.confetti(refs.Root,low,data.VictoryColor);Audio.play("Victory") end
    end
end)
player.CharacterAdded:Connect(function() task.defer(function() if not spectating then resetCamera() end end) end)
local lastEffects=0
RunService.RenderStepped:Connect(function()
    local now=workspace:GetServerTimeNow();local remaining=math.max(0,(state.Deadline or 0)-now)
    refs.Timer.Text=if state.State=="Waiting" then "—" else string.format("%02d:%02d",math.floor(remaining/60),math.floor(remaining%60))
    if state.State=="RoundIntro" then
        local count=math.max(1,math.ceil(remaining));refs.Quota.Text=tostring(count).."..."
        if count~=lastCountdown then lastCountdown=count;Audio.play("Countdown") end
    else lastCountdown=-1 end
    if state.Chaos and state.Chaos.Next then refs.ChaosText.Text=language.Chaos.." "..math.max(0,math.ceil(state.Chaos.Next-now)) end
    refs.Power.Visible=canPower();refs.PowerHint.Visible=refs.Power.Visible
    local cd=math.max(0,(state.Cooldown or 0)-now)
    local power=Config.Powers[state.Power or "Dash"]
    refs.Power.Text=if cd>0 then tostring(math.ceil(cd)) else (if UIS.TouchEnabled then language.Power else "Q")
    refs.PowerHint.Text=power and power.Name or "Dash";refs.Power.BackgroundColor3=if cd>0 then UI.Colors.Panel else UI.Colors.Blue
    local smallHeight=refs.Root.AbsoluteSize.Y<450
    refs.Power.Position=UDim2.fromScale(0.86,if smallHeight then 0.48 else 0.62);refs.PowerHint.Position=refs.Power.Position
    if now>=toastUntil then refs.Toast.Visible=false end
    if now-lastEffects>1 then
        lastEffects=now
        Accessibility.update(workspace:FindFirstChild("RoyalRushArena"),settings.ColorAssist)
        for _,object in workspace:GetDescendants() do
            if object:IsA("Trail") and object.Parent and object.Parent.Name=="RoyalCosmetics" then object.Enabled=not settings.ReducedParticles and not settings.LowEffects end
        end
    end
end)
send("Sync")
print("[Royal Rush client] "..Config.Version.." • Q or touch POWER")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="818">
          <Properties>
            <string name="Name">SurfaceMotion</string>
            <string name="Source"><![CDATA[local RunService=game:GetService("RunService")
local Motion=require(game:GetService("ReplicatedStorage").RoyalRush.ObstacleMotion)
local Surface={Entries={},Arena=nil,Connection=nil,Added=nil}
function Surface:_add(object)
    if not object:IsA("BasePart") or object.Name~="Body" then return end
    local model=object.Parent
    if not model or not model:GetAttribute("ObstacleType") then return end
    self.Entries[object]=model
end
function Surface:_arena(arena)
    if self.Added then self.Added:Disconnect();self.Added=nil end
    self.Entries={};self.Arena=arena
    if not arena then return end
    for _,object in arena:GetDescendants() do self:_add(object) end
    self.Added=arena.DescendantAdded:Connect(function(object) self:_add(object) end)
end
function Surface.start()
    if Surface.Connection then return end
    Surface.Connection=RunService.PreSimulation:Connect(function()
        local arena=workspace:FindFirstChild("RoyalRushArena")
        if arena~=Surface.Arena then Surface:_arena(arena) end
        if not arena then return end
        local start=arena:GetAttribute("RoundStartedAt")
        local elapsed=if start then math.max(0,workspace:GetServerTimeNow()-start) else 0
        for body,model in Surface.Entries do
            if not body.Parent then Surface.Entries[body]=nil;continue end
            local base=body:GetAttribute("MotionBase")
            if not base then continue end
            local kind=model:GetAttribute("ObstacleType")
            local cframe,velocity,inactive=Motion.sample(kind,base,elapsed,model:GetAttribute("Period"),model:GetAttribute("Phase"),model:GetAttribute("Distance"))
            if kind=="Conveyor" then
                -- Anchored surface velocity contributes to contact physics;
                -- never overwrite the player's velocity/input each frame.
                body.AssemblyLinearVelocity=base:VectorToWorldSpace(Vector3.new(0,0,model:GetAttribute("BeltSpeed") or 6))
            else
                body.CFrame=cframe
                if body:GetAttribute("Carry") then body.AssemblyLinearVelocity=velocity end
            end
            if kind=="DoorTiming" or kind=="LaserGate" then body.Transparency=if inactive then 0.88 else 0.15 end
        end
    end)
end
return Surface
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="819">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[local UI={}
UI.Colors={Navy=Color3.fromRGB(18,25,45),Panel=Color3.fromRGB(29,37,62),White=Color3.fromRGB(240,245,255),Muted=Color3.fromRGB(163,180,208),Gold=Color3.fromRGB(255,211,82),Purple=Color3.fromRGB(168,108,250),Blue=Color3.fromRGB(87,186,255),Green=Color3.fromRGB(84,224,166),Red=Color3.fromRGB(255,112,107)}
function UI.create(class,parent,properties)
    local object=Instance.new(class)
    for key,value in properties or {} do object[key]=value end
    object.Parent=parent;return object
end
function UI.round(frame,radius)
    UI.create("UICorner",frame,{CornerRadius=UDim.new(0,radius or 12)})
end
function UI.panel(parent,name,size,position)
    local frame=UI.create("Frame",parent,{Name=name,Size=size,Position=position or UDim2.new(),BackgroundColor3=UI.Colors.Panel,BackgroundTransparency=0.08,BorderSizePixel=0})
    UI.round(frame);UI.create("UIStroke",frame,{Color=UI.Colors.Purple,Transparency=0.72,Thickness=1})
    return frame
end
function UI.label(parent,name,text,size,position,textSize,color)
    return UI.create("TextLabel",parent,{Name=name,Text=text or "",Size=size,Position=position or UDim2.new(),BackgroundTransparency=1,TextColor3=color or UI.Colors.White,TextSize=textSize or 18,FontFace=Font.new("rbxasset://fonts/families/SourceSansPro.json",Enum.FontWeight.Bold,Enum.FontStyle.Normal),TextWrapped=true})
end
function UI.button(parent,name,text,size,position,color)
    local button=UI.create("TextButton",parent,{Name=name,Text=text or "",Size=size,Position=position or UDim2.new(),BackgroundColor3=color or UI.Colors.Purple,TextColor3=UI.Colors.White,TextSize=14,FontFace=Font.new("rbxasset://fonts/families/SourceSansPro.json",Enum.FontWeight.Bold,Enum.FontStyle.Normal),AutoButtonColor=true,BorderSizePixel=0})
    UI.round(button,10);return button
end
function UI.build(playerGui)
    local old=playerGui:FindFirstChild("RoyalRushHUD");if old then old:Destroy() end
    local gui=UI.create("ScreenGui",playerGui,{Name="RoyalRushHUD",ResetOnSpawn=false,IgnoreGuiInset=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=10})
    pcall(function() gui.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets end)
    local root=UI.create("Frame",gui,{Name="SafeRoot",Size=UDim2.fromScale(1,1),BackgroundTransparency=1})
    local header=UI.panel(root,"RoundHeader",UDim2.new(0.70,0,0,80),UDim2.new(0.5,0,0,8));header.AnchorPoint=Vector2.new(0.5,0)
    UI.create("UISizeConstraint",header,{MinSize=Vector2.new(220,80),MaxSize=Vector2.new(540,80)})
    local name=UI.label(header,"RoundName","ROYAL RUSH",UDim2.new(1,-18,0,27),UDim2.fromOffset(9,6),20,UI.Colors.Gold)
    local objective=UI.label(header,"Objective","CHAOS + CROWN",UDim2.new(1,-18,0,20),UDim2.fromOffset(9,35),14,UI.Colors.White)
    local quota=UI.label(header,"Quota","",UDim2.new(1,-18,0,17),UDim2.fromOffset(9,58),13,UI.Colors.Muted)
    local timer=UI.label(root,"Timer","00:00",UDim2.fromOffset(80,38),UDim2.new(1,-84,0,94),25,UI.Colors.Gold)
    local stats=UI.label(root,"Progress","",UDim2.new(1,-105,0,36),UDim2.fromOffset(8,96),13,UI.Colors.White);stats.TextXAlignment=Enum.TextXAlignment.Left
    local saved=UI.label(root,"SaveStatus","",UDim2.new(1,-20,0,18),UDim2.new(0,10,1,-22),11,UI.Colors.Muted)
    local chaos=UI.panel(root,"Chaos",UDim2.new(0.70,0,0,36),UDim2.new(0.5,0,0,140));chaos.AnchorPoint=Vector2.new(0.5,0);chaos.Visible=false
    UI.create("UISizeConstraint",chaos,{MaxSize=Vector2.new(470,36),MinSize=Vector2.new(220,36)})
    local chaosText=UI.label(chaos,"Event","",UDim2.fromScale(1,1),nil,16,UI.Colors.Purple)
    local toolbar=UI.create("Frame",root,{Name="LobbyToolbar",Size=UDim2.new(1,-20,0,36),Position=UDim2.fromOffset(10,187),BackgroundTransparency=1})
    local buttons={}
    for index,tab in {"Loadout","Shop","Daily","Settings"} do buttons[tab]=UI.button(toolbar,tab,string.upper(tab),UDim2.new(0.24,0,1,0),UDim2.new((index-1)*0.253,0,0,0),if tab=="Shop" then Color3.fromRGB(119,91,39) else UI.Colors.Panel) end
    local queue=UI.button(root,"Queue","AUTO QUEUE",UDim2.fromOffset(150,34),UDim2.fromOffset(10,234),UI.Colors.Panel)
    local power=UI.button(root,"Power","Q\nDASH",UDim2.fromOffset(74,74),UDim2.fromScale(0.86,0.62),UI.Colors.Blue);power.AnchorPoint=Vector2.new(0.5,0.5);UI.round(power,37);power.Visible=false
    local powerLabel=UI.label(root,"PowerHint","",UDim2.fromOffset(88,20),UDim2.fromScale(0.86,0.62),12,UI.Colors.White);powerLabel.AnchorPoint=Vector2.new(0.5,-2.2);powerLabel.Visible=false
    local watch=UI.button(root,"Watch","SPECTATE",UDim2.fromOffset(112,38),UDim2.new(0.5,-116,1,-96),UI.Colors.Purple);watch.Visible=false
    local lobby=UI.button(root,"Lobby","LOBBY",UDim2.fromOffset(112,38),UDim2.new(0.5,4,1,-96),UI.Colors.Panel);lobby.Visible=false
    local spectator=UI.panel(root,"Spectator",UDim2.fromOffset(230,40),UDim2.new(0.5,0,1,-145));spectator.AnchorPoint=Vector2.new(0.5,0);spectator.Visible=false
    local previous=UI.button(spectator,"Previous","<",UDim2.fromOffset(35,32),UDim2.fromOffset(4,4),UI.Colors.Panel)
    local next_=UI.button(spectator,"Next",">",UDim2.fromOffset(35,32),UDim2.new(1,-39,0,4),UI.Colors.Panel)
    local target=UI.label(spectator,"Target","",UDim2.new(1,-80,1,0),UDim2.fromOffset(40,0),13,UI.Colors.White)
    local toast=UI.panel(root,"Toast",UDim2.new(0.88,0,0,54),UDim2.new(0.5,0,0.40,0));toast.AnchorPoint=Vector2.new(0.5,0.5);toast.Visible=false
    UI.create("UISizeConstraint",toast,{MaxSize=Vector2.new(560,80),MinSize=Vector2.new(240,54)})
    local toastText=UI.label(toast,"Message","",UDim2.new(1,-20,1,0),UDim2.fromOffset(10,0),19,UI.Colors.White)
    local modal=UI.panel(root,"Modal",UDim2.fromScale(0.92,0.70),UDim2.fromScale(0.5,0.5));modal.AnchorPoint=Vector2.new(0.5,0.5);modal.Visible=false;modal.ZIndex=20
    UI.create("UISizeConstraint",modal,{MinSize=Vector2.new(260,260),MaxSize=Vector2.new(620,580)})
    local modalTitle=UI.label(modal,"Title","",UDim2.new(1,-96,0,40),UDim2.fromOffset(14,8),23,UI.Colors.Gold);modalTitle.TextXAlignment=Enum.TextXAlignment.Left
    local close=UI.button(modal,"Close","X",UDim2.fromOffset(40,34),UDim2.new(1,-50,0,10),UI.Colors.Panel)
    local content=UI.create("ScrollingFrame",modal,{Name="Content",Size=UDim2.new(1,-24,1,-68),Position=UDim2.fromOffset(12,56),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y})
    UI.create("UIListLayout",content,{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder})
    return {Gui=gui,Root=root,Name=name,Objective=objective,Quota=quota,Timer=timer,Stats=stats,Saved=saved,Chaos=chaos,ChaosText=chaosText,Toolbar=toolbar,Buttons=buttons,Queue=queue,Power=power,PowerHint=powerLabel,Watch=watch,Lobby=lobby,Spectator=spectator,Previous=previous,Next=next_,Target=target,Toast=toast,ToastText=toastText,Modal=modal,ModalTitle=modalTitle,Close=close,Content=content}
end
function UI.clearContent(content)
    for _,child in content:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
end
function UI.row(content,title,detail,color)
    local row=UI.panel(content,"Card",UDim2.new(1,-8,0,96));row.BackgroundColor3=UI.Colors.Navy
    local label=UI.label(row,"Title",title,UDim2.new(1,-120,0,30),UDim2.fromOffset(10,7),15,color or UI.Colors.White);label.TextXAlignment=Enum.TextXAlignment.Left
    local description=UI.label(row,"Detail",detail,UDim2.new(1,-120,0,50),UDim2.fromOffset(10,35),13,UI.Colors.Muted);description.TextXAlignment=Enum.TextXAlignment.Left
    local action=UI.button(row,"Action","",UDim2.fromOffset(96,34),UDim2.new(1,-105,0.5,-17),UI.Colors.Purple)
    return action,row
end
return UI
]]></string>
